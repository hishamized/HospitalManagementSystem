@{
    ViewData["Title"] = "Doctor–Ward Assignment";
}

<div class="min-h-screen bg-gray-900 py-6">
    <div class="container mx-auto px-2">
        <!-- Doctor-Ward Assignments Grid Section -->
        <div class="mb-6 overflow-hidden rounded-lg border border-gray-700 bg-gray-800 shadow-2xl">
            <!-- Header -->
            <div class="flex items-center justify-between bg-gradient-to-r from-purple-600 to-purple-700 px-4 py-3">
                <h4 class="text-lg font-semibold text-white">Doctor–Ward Assignments</h4>
                <button id="refreshBtn" class="flex items-center gap-2 rounded bg-purple-200 px-3 py-1.5 text-sm font-medium text-purple-900 transition-all hover:bg-purple-100 hover:shadow-md">
                    <i class="fa-solid fa-arrows-rotate"></i> Refresh
                </button>
            </div>

            <!-- Body -->
            <div class="p-4">
                <div id="assignmentGrid" class="ag-theme-alpine-dark" style="height: 550px; width: 100%;"></div>
            </div>
        </div>

        <!-- Assign Doctor to Ward Form Section -->
        <div class="overflow-hidden rounded-lg border border-gray-700 bg-gray-800 shadow-2xl">
            <!-- Header -->
            <div class="flex items-center justify-between bg-gradient-to-r from-purple-600 to-purple-700 px-4 py-3">
                <h5 class="text-lg font-semibold text-white">Assign Doctor to Ward</h5>
                <button id="refreshListsBtn" class="flex items-center gap-2 rounded bg-purple-200 px-3 py-1.5 text-sm font-medium text-purple-900 transition-all hover:bg-purple-100 hover:shadow-md">
                    <i class="fa-solid fa-arrows-rotate"></i> Refresh Lists
                </button>
            </div>

            <!-- Body / Form -->
            <div class="p-6">
                <form id="assignForm">
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
                        <!-- Doctor Selection -->
                        <div>
                            <label for="doctorSelect" class="mb-2 block font-semibold text-gray-200">Select Doctor</label>
                            <select id="doctorSelect" class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2.5 text-gray-100 transition-all focus:border-purple-500 focus:outline-none focus:ring-2 focus:ring-purple-500">
                                <option value="">-- Choose Doctor --</option>
                            </select>
                        </div>

                        <!-- Ward Selection -->
                        <div>
                            <label for="wardSelect" class="mb-2 block font-semibold text-gray-200">Select Ward</label>
                            <select id="wardSelect" class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2.5 text-gray-100 transition-all focus:border-purple-500 focus:outline-none focus:ring-2 focus:ring-purple-500">
                                <option value="">-- Choose Ward --</option>
                            </select>
                        </div>

                        <!-- Remarks Field -->
                        <div>
                            <label for="remarks" class="mb-2 block font-semibold text-gray-200">Remarks</label>
                            <input type="text" id="remarks" placeholder="Optional notes (e.g. Night Shift)"
                                   class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2.5 text-gray-100 placeholder-gray-400 transition-all focus:border-purple-500 focus:outline-none focus:ring-2 focus:ring-purple-500">
                        </div>
                    </div>

                    <!-- Hidden Field for AssignedBy -->
                    @if (Context.Session.GetString("UserId") != null)
                    {
                        <input type="hidden" id="assignedBy" value="@Context.Session.GetString("UserId")" />
                    }

                    <!-- Submit Button -->
                    <div class="mt-6 text-right">
                        <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-purple-600 to-purple-700 px-6 py-2.5 font-semibold text-white shadow-lg transition-all hover:from-purple-700 hover:to-purple-800 hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2 focus:ring-offset-gray-800">
                            <i class="fa-solid fa-check-circle"></i> Assign
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Toast Notification -->
        <div class="fixed bottom-4 right-4 z-50">
            <div id="toast" class="hidden min-w-[300px] items-center justify-between rounded-lg bg-purple-600 px-4 py-3 text-white shadow-2xl" role="alert">
                <div class="flex items-center gap-3">
                    <i id="toastIcon" class="fa-solid fa-check-circle text-xl"></i>
                    <div id="toastMsg" class="font-medium">Assignment successful!</div>
                </div>
                <button type="button" id="toastClose" class="ml-4 text-white transition-colors hover:text-gray-200">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Ward/assignment.js"></script>
}