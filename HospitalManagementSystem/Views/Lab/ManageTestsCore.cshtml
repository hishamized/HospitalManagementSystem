@{
    ViewData["Title"] = "ManageTestsCore";
}

<div class="container mx-auto mt-4 px-4 sm:px-6 lg:px-8">
    <!-- Page Header -->
    <div class="mb-4 flex items-center justify-between">
        <h4 class="text-xl font-bold text-purple-600">Manage Lab Tests</h4>
        <button type="button"
                id="addTestBtn"
                class="flex items-center gap-2 rounded bg-purple-600 px-4 py-2 text-white shadow hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-purple-500">
            <i class="fas fa-plus-circle"></i> Add Test
        </button>
    </div>

    <!-- AG Grid Container -->
    <div class="rounded-lg bg-gray-900 p-4 shadow">
        <div id="labTestsGrid" class="ag-theme-alpine-dark h-[600px] w-full"></div>
    </div>
</div>

<!-- Add Lab Test Modal -->
<div id="addLabTestModal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-labelledby="addLabTestModalLabel">
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative z-10 flex min-h-screen items-center justify-center p-4">
        <div class="w-full max-w-3xl overflow-hidden rounded-lg bg-gray-900 shadow-lg">
            <!-- Modal Header -->
            <div class="flex items-center justify-between bg-purple-600 px-4 py-3 text-white">
                <h5 class="flex items-center gap-2 text-base font-semibold" id="addLabTestModalLabel">
                    <i class="fas fa-vial"></i> Add New Lab Test
                </h5>
                <button type="button"
                        onclick="hideModal('addLabTestModal')"
                        data-modal="addLabTestModal"
                        aria-label="Close"
                        class="inline-flex h-8 w-8 items-center justify-center rounded hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-4">
                <form id="addLabTestForm">
                    @Html.AntiForgeryToken()

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <!-- Test Name -->
                        <div class="mb-3">
                            <label for="testName" class="mb-1 block font-semibold text-gray-100">Test Name <span class="text-red-500">*</span></label>
                            <input type="text" id="testName" name="TestName" required
                                   placeholder="e.g., Complete Blood Count"
                                   class="w-full rounded-md border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100 shadow-sm focus:border-purple-500 focus:ring-2 focus:ring-purple-500">
                            <div class="mt-1 hidden text-sm text-red-500">Please provide a test name.</div>
                        </div>

                        <!-- Sample Type -->
                        <div class="mb-3">
                            <label for="sampleType" class="mb-1 block font-semibold text-gray-100">Sample Type</label>
                            <select id="sampleType" name="SampleType"
                                    class="w-full rounded-md border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100 shadow-sm focus:border-purple-500 focus:ring-2 focus:ring-purple-500">
                                <option value="">Select Sample Type</option>
                                <option value="Blood">Blood</option>
                                <option value="Urine">Urine</option>
                                <option value="Saliva">Saliva</option>
                                <option value="Stool">Stool</option>
                                <option value="Tissue">Tissue</option>
                                <option value="Swab">Swab</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <!-- Normal Range -->
                        <div class="mb-3">
                            <label for="normalRange" class="mb-1 block font-semibold text-gray-100">Normal Range <span class="text-red-500">*</span></label>
                            <input type="text" id="normalRange" name="NormalRange" required
                                   placeholder="e.g., 4.5-11.0 x10^9/L"
                                   class="w-full rounded-md border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100 shadow-sm focus:border-purple-500 focus:ring-2 focus:ring-purple-500">
                            <div class="mt-1 hidden text-sm text-red-500">Please provide the normal range.</div>
                        </div>

                        <!-- Price -->
                        <div class="mb-3">
                            <label for="price" class="mb-1 block font-semibold text-gray-100">Price</label>
                            <div class="flex items-center">
                                <span class="rounded-l-md border border-r-0 border-gray-700 bg-gray-700 px-3 py-2 text-gray-100">$</span>
                                <input type="number" id="price" name="Price" step="0.01" min="0" placeholder="0.00"
                                       class="w-full rounded-r-md border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100 focus:border-purple-500 focus:ring-2 focus:ring-purple-500">
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label for="description" class="mb-1 block font-semibold text-gray-100">Description</label>
                        <textarea id="description" name="Description" rows="3"
                                  placeholder="Enter test description, purpose, and any special instructions..."
                                  class="w-full rounded-md border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100 shadow-sm focus:border-purple-500 focus:ring-2 focus:ring-purple-500"></textarea>
                    </div>

                    <!-- Is Active -->
                    <div class="mb-3 flex items-center gap-2">
                        <input type="checkbox" id="isActive" name="IsActive" checked
                               class="h-4 w-4 rounded border-gray-700 bg-gray-800 text-purple-600 focus:ring-purple-500">
                        <label for="isActive" class="font-medium text-gray-100">Active Test</label>
                    </div>

                    <!-- Hidden fields -->
                    <input type="hidden" id="createdAt" name="CreatedAt">
                </form>
            </div>

            <!-- Modal Footer -->
            <div class="flex justify-end gap-2 bg-gray-800 px-4 py-3">
                <button type="button" onclick="hideModal('addLabTestModal')" data-modal="addLabTestModal"
                        class="flex items-center gap-2 rounded bg-gray-700 px-4 py-2 text-gray-100 shadow hover:bg-gray-600 focus:ring-2 focus:ring-purple-500">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="submit" form="addLabTestForm"
                        class="flex items-center gap-2 rounded bg-purple-600 px-4 py-2 text-white shadow hover:bg-purple-700 focus:ring-2 focus:ring-purple-500">
                    <i class="fas fa-save"></i> Save Lab Test
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Lab Test Modal -->
<div id="editLabTestModal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-labelledby="editLabTestModalLabel">
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative z-10 flex min-h-screen items-center justify-center p-4">
        <div class="w-full max-w-3xl overflow-hidden rounded-lg bg-gray-900 shadow-lg">
            <!-- Modal Header -->
            <div class="flex items-center justify-between bg-purple-600 px-4 py-3 text-white">
                <h5 class="flex items-center gap-2 text-base font-semibold" id="editLabTestModalLabel">
                    <i class="fas fa-pencil-alt"></i> Edit Lab Test
                </h5>
                <button type="button" data-modal="editLabTestModal"
                        aria-label="Close"
                        onclick="hideModal('editLabTestModal')"
                        class="inline-flex h-8 w-8 items-center justify-center rounded hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-4">
                <form id="editLabTestForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editTestId" name="Id">

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <!-- Test Name -->
                        <div class="mb-3">
                            <label for="editTestName" class="mb-1 block font-semibold text-gray-100">Test Name <span class="text-red-500">*</span></label>
                            <input type="text" id="editTestName" name="TestName" required
                                   placeholder="e.g., Complete Blood Count"
                                   class="w-full rounded-md border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100 shadow-sm focus:border-purple-500 focus:ring-2 focus:ring-purple-500">
                            <div class="mt-1 hidden text-sm text-red-500">Please provide a test name.</div>
                        </div>

                        <!-- Sample Type -->
                        <div class="mb-3">
                            <label for="editSampleType" class="mb-1 block font-semibold text-gray-100">Sample Type</label>
                            <select id="editSampleType" name="SampleType"
                                    class="w-full rounded-md border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100 shadow-sm focus:border-purple-500 focus:ring-2 focus:ring-purple-500">
                                <option value="">Select Sample Type</option>
                                <option value="Blood">Blood</option>
                                <option value="Urine">Urine</option>
                                <option value="Saliva">Saliva</option>
                                <option value="Stool">Stool</option>
                                <option value="Tissue">Tissue</option>
                                <option value="Swab">Swab</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <!-- Normal Range -->
                        <div class="mb-3">
                            <label for="editNormalRange" class="mb-1 block font-semibold text-gray-100">Normal Range <span class="text-red-500">*</span></label>
                            <input type="text" id="editNormalRange" name="NormalRange" required
                                   placeholder="e.g., 4.5-11.0 x10^9/L"
                                   class="w-full rounded-md border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100 shadow-sm focus:border-purple-500 focus:ring-2 focus:ring-purple-500">
                            <div class="mt-1 hidden text-sm text-red-500">Please provide the normal range.</div>
                        </div>

                        <!-- Price -->
                        <div class="mb-3">
                            <label for="editPrice" class="mb-1 block font-semibold text-gray-100">Price</label>
                            <div class="flex items-center">
                                <span class="rounded-l-md border border-r-0 border-gray-700 bg-gray-700 px-3 py-2 text-gray-100">$</span>
                                <input type="number" id="editPrice" name="Price" step="0.01" min="0" placeholder="0.00"
                                       class="w-full rounded-r-md border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100 focus:border-purple-500 focus:ring-2 focus:ring-purple-500">
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label for="editDescription" class="mb-1 block font-semibold text-gray-100">Description</label>
                        <textarea id="editDescription" name="Description" rows="3"
                                  placeholder="Enter test description, purpose, and any special instructions..."
                                  class="w-full rounded-md border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100 shadow-sm focus:border-purple-500 focus:ring-2 focus:ring-purple-500"></textarea>
                    </div>

                    <!-- Is Active -->
                    <div class="mb-3 flex items-center gap-2">
                        <input type="checkbox" id="editIsActive" name="IsActive"
                               class="h-4 w-4 rounded border-gray-700 bg-gray-800 text-purple-600 focus:ring-purple-500">
                        <label for="editIsActive" class="font-medium text-gray-100">Active Test</label>
                    </div>

                    <input type="hidden" id="editCreatedAt" name="CreatedAt">
                    <input type="hidden" id="editUpdatedAt" name="UpdatedAt">
                </form>
            </div>

            <!-- Modal Footer -->
            <div class="flex justify-end gap-2 bg-gray-800 px-4 py-3">
                <button type="button" data-modal="editLabTestModal"
                        onclick="hideModal('editLabTestModal')"   
                        class="flex items-center gap-2 rounded bg-gray-700 px-4 py-2 text-gray-100 shadow hover:bg-gray-600 focus:ring-2 focus:ring-purple-500">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="submit" form="editLabTestForm"
                        class="flex items-center gap-2 rounded bg-purple-600 px-4 py-2 text-white shadow hover:bg-purple-700 focus:ring-2 focus:ring-purple-500">
                    <i class="fas fa-save"></i> Update Lab Test
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Lab/ManageTestsCore.js"></script>
}
