@{
    ViewData["Title"] = "Beds";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Bed Management</h3>
        <button id="btnShowAll" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-list-ul"></i> Show All Beds
        </button>
        <button type="button" class="btn btn-primary" id="btnAddBed">Add Bed</button>
    </div>

    <div id="bedGrid" class="ag-theme-alpine" style="height: 500px; width: 100%;"></div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <button id="prevPage" class="btn btn-secondary">Previous</button>
        <span id="pageInfo"></span>
        <button id="nextPage" class="btn btn-secondary">Next</button>
    </div>
</div>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Beds</h4>
 
    </div>

    <div id="bedGrid" class="ag-theme-alpine" style="height: 500px; width: 100%;"></div>
</div>

<div class="modal fade" id="bedModal" tabindex="-1" aria-labelledby="bedModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="bedModalLabel">Add Bed</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="bedForm">
                    @Html.AntiForgeryToken()
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Bed Code</label>
                            <input type="text" class="form-control" id="BedCode" name="BedCode" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Bed Number</label>
                            <input type="text" class="form-control" id="BedNumber" name="BedNumber" required>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Ward</label>
                            <select class="form-select" id="WardId" name="WardId" required></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Bed Type</label>
                            <input type="text" class="form-control" id="BedType" name="BedType">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Status</label>
                            <input type="text" class="form-control" id="Status" name="Status">
                        </div>
                        <div class="col-md-6 d-flex align-items-center">
                            <div class="form-check mt-3">
                                <input class="form-check-input" type="checkbox" id="IsOccupied" name="IsOccupied">
                                <label class="form-check-label">Occupied</label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" id="Description" name="Description" rows="2"></textarea>
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-success">Save Bed</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Bed Modal -->
<div class="modal fade" id="editBedModal" tabindex="-1" aria-labelledby="editBedModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="editBedModalLabel">Edit Bed</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editBedForm">
                    <input type="hidden" id="editBedId" />
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editBedCode" class="form-label">Bed Code</label>
                            <input type="text" class="form-control" id="editBedCode" readonly />
                        </div>
                        <div class="col-md-6">
                            <label for="editBedNumber" class="form-label">Bed Number</label>
                            <input type="text" class="form-control" id="editBedNumber" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editWardName" class="form-label">Ward</label>
                            <input type="text" class="form-control" id="editWardName" readonly />
                        </div>
                        <div class="col-md-6">
                            <label for="editBedType" class="form-label">Bed Type</label>
                            <input type="text" class="form-control" id="editBedType" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editIsOccupied" class="form-label">Occupied</label>
                            <select id="editIsOccupied" class="form-select">
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="editStatus" class="form-label">Status</label>
                            <input type="text" class="form-control" id="editStatus" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="editDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="editDescription" rows="3"></textarea>
                    </div>
                    <button type="submit" class="btn btn-success">Save Changes</button>
                </form>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script src="~/js/Bed/bed.js"></script>
}
