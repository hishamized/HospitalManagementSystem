@model HMS.Application.DTO.DoctorPortal.DoctorLoginDto

@{
    ViewData["Title"] = "Doctor Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
        }
    </style>
</head>

<body class="min-h-screen bg-gradient-to-br from-gray-900 via-purple-900 to-gray-900 flex items-center justify-center p-4">

    <div class="w-full max-w-md">
        <div class="bg-gray-800 rounded-2xl shadow-2xl border border-gray-700 overflow-hidden">

            <!-- Header -->
            <div class="bg-gradient-to-r from-purple-600 to-purple-700 text-center pt-8 pb-6">
                <div class="bg-white/10 backdrop-blur-sm rounded-full w-24 h-24 flex items-center justify-center mx-auto mb-4 shadow-lg">
                    <i class="fas fa-user-md text-white text-5xl"></i>
                </div>
                <h3 class="text-3xl font-bold text-white mb-2">Doctor Portal</h3>
                <p class="text-purple-200 text-sm">Sign in to access your dashboard</p>
            </div>

            <!-- Body -->
            <div class="px-8 py-6">

                <div id="loginMessage"></div>

                <form id="doctorLoginForm" method="post" class="space-y-5">
                    @Html.AntiForgeryToken()

                    <!-- Identifier -->
                    <div>
                        <label asp-for="Identifier" class="block text-gray-300 font-semibold mb-2 text-sm">
                            <i class="fas fa-user text-purple-400 mr-2"></i>Email, Doctor Code or Phone
                        </label>

                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-id-card text-gray-400"></i>
                            </div>
                            <input asp-for="Identifier"
                                   id="Identifier"
                                   class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg pl-12 pr-4 py-3 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                                   placeholder="Enter your identifier" />
                        </div>

                        <span asp-validation-for="Identifier"
                              class="text-red-400 text-xs mt-1 block"></span>
                    </div>

                    <!-- Password -->
                    <div>
                        <label asp-for="Password" class="block text-gray-300 font-semibold mb-2 text-sm">
                            <i class="fas fa-lock text-purple-400 mr-2"></i>Password
                        </label>

                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-key text-gray-400"></i>
                            </div>
                            <input asp-for="Password"
                                   type="password"
                                   id="Password"
                                   class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg pl-12 pr-12 py-3 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                                   placeholder="Enter your password" />
                            <button type="button"
                                    id="togglePassword"
                                    class="absolute inset-y-0 right-0 pr-4 flex items-center">
                                <i class="fas fa-eye text-gray-400 hover:text-purple-400 transition-colors" id="eyeIcon"></i>
                            </button>
                        </div>

                        <span asp-validation-for="Password"
                              class="text-red-400 text-xs mt-1 block"></span>
                    </div>

                    <!-- Remember Me & Forgot Password -->
                    <div class="flex justify-between items-center">
                        <label class="flex items-center gap-2 cursor-pointer group">
                            <input asp-for="RememberMe"
                                   id="rememberCheck"
                                   type="checkbox"
                                   class="w-5 h-5 rounded bg-gray-700 border-gray-600 text-purple-600 focus:ring-purple-500 focus:ring-2 cursor-pointer" />
                            <span class="text-gray-300 text-sm group-hover:text-purple-400 transition-colors">
                                Remember Me
                            </span>
                        </label>

                        <a href="#" class="text-purple-400 hover:text-purple-300 text-sm font-semibold transition-colors">
                            Forgot Password?
                        </a>
                    </div>

                    <!-- Submit Button -->
                    <div class="pt-2">
                        <button type="submit"
                                class="w-full bg-gradient-to-r from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 text-white font-bold py-3 rounded-lg shadow-lg transition-all transform hover:scale-[1.02] active:scale-[0.98]"
                                id="loginBtn">
                            <i class="fas fa-sign-in-alt mr-2"></i>Sign In
                        </button>
                    </div>

                    <!-- Divider -->
                    <div class="relative py-4">
                        <div class="absolute inset-0 flex items-center">
                            <div class="w-full border-t border-gray-700"></div>
                        </div>
                        <div class="relative flex justify-center text-sm">
                            <span class="px-4 bg-gray-800 text-gray-400">OR</span>
                        </div>
                    </div>

                    <!-- Home Page Link -->
                    <div class="text-center">
                        <p class="text-gray-400 text-sm mb-3">Don't have an account?</p>
                        <a href="/Home/Index"
                           class="inline-flex items-center justify-center px-6 py-2 bg-gray-700 hover:bg-gray-600 text-gray-300 hover:text-white font-semibold rounded-lg transition-all border border-gray-600 hover:border-purple-500">
                            <i class="fas fa-home mr-2"></i>Home Page
                        </a>
                    </div>
                </form>

            </div>

            <!-- Footer -->
            <div class="bg-gray-900 border-t border-gray-700 text-center py-4">
                <p class="text-gray-400 text-sm">
                    <i class="fas fa-shield-alt text-green-500 mr-2"></i>
                    Secure Login • Protected by HMS
                </p>
            </div>

        </div>

        <!-- Bottom Text -->
        <div class="text-center mt-6 space-y-2">
            <p class="text-white text-sm">
                <i class="fas fa-headset mr-2"></i>Need Help? Contact Support
            </p>
            <p class="text-gray-400 text-xs">
                © 2024 Hospital Management System. All rights reserved.
            </p>
        </div>

    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function () {

            // Password Toggle
            $("#togglePassword").click(function () {
                var passwordInput = $("#Password");
                var eyeIcon = $("#eyeIcon");

                if (passwordInput.attr("type") === "password") {
                    passwordInput.attr("type", "text");
                    eyeIcon.removeClass("fa-eye").addClass("fa-eye-slash");
                } else {
                    passwordInput.attr("type", "password");
                    eyeIcon.removeClass("fa-eye-slash").addClass("fa-eye");
                }
            });

            // AJAX Login
            $("#doctorLoginForm").submit(function (e) {
                e.preventDefault();

                var token = $('input[name="__RequestVerificationToken"]').val();
                var loginBtn = $("#loginBtn");
                var originalBtnText = loginBtn.html();

                loginBtn.prop('disabled', true).html(
                    '<svg class="animate-spin inline-block w-5 h-5 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">' +
                    '<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>' +
                    '<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>' +
                    '</svg>Signing in...'
                );

                var formData = {
                    Identifier: $("#Identifier").val(),
                    Password: $("#Password").val(),
                    RememberMe: $("#rememberCheck").is(":checked")
                };

                $.ajax({
                    url: '@Url.Action("Login", "DoctorPortal")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    headers: { 'RequestVerificationToken': token },

                    success: function (res) {
                        if (res.success) {
                            $("#loginMessage").html(
                                '<div class="bg-green-600/20 border border-green-500 text-green-300 p-4 rounded-lg mb-4 flex items-center animate-fade-in">' +
                                '<i class="fas fa-check-circle mr-3 text-xl"></i>' +
                                '<span>Login successful! Redirecting…</span>' +
                                '</div>'
                            );

                            setTimeout(() => window.location.href = res.redirectUrl, 1000);
                        } else {
                            loginBtn.prop('disabled', false).html(originalBtnText);

                            $("#loginMessage").html(
                                '<div class="bg-red-600/20 border border-red-500 text-red-300 p-4 rounded-lg mb-4 flex items-center animate-shake">' +
                                '<i class="fas fa-exclamation-triangle mr-3 text-xl"></i>' +
                                '<span>' + res.message + '</span>' +
                                '</div>'
                            );
                        }
                    },

                    error: function (xhr) {
                        loginBtn.prop('disabled', false).html(originalBtnText);

                        $("#loginMessage").html(
                            '<div class="bg-red-600/20 border border-red-500 text-red-300 p-4 rounded-lg mb-4 flex items-center animate-shake">' +
                            '<i class="fas fa-times-circle mr-3 text-xl"></i>' +
                            '<span>Login failed. Please try again.</span>' +
                            '</div>'
                        );
                    }
                });
            });

            // Focus effects on inputs
            $('input').on('focus', function () {
                $(this).addClass('ring-2 ring-purple-500 scale-[1.01]');
            }).on('blur', function () {
                $(this).removeClass('ring-2 ring-purple-500 scale-[1.01]');
            });

        });
    </script>

    <style>
        @@keyframes fade-in {
            from

        {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        @@keyframes shake {
            0%, 100%

        {
            transform: translateX(0);
        }

        10%, 30%, 50%, 70%, 90% {
            transform: translateX(-5px);
        }

        20%, 40%, 60%, 80% {
            transform: translateX(5px);
        }

        }

        .animate-fade-in {
            animation: fade-in 0.5s ease-out;
        }

        .animate-shake {
            animation: shake 0.5s ease-in-out;
        }
    </style>

</body>
</html>