@model HMS.Application.DTO.DoctorPortal.ViewPatientDto

@{
    ViewData["Title"] = "Patient Details";
}

<div class="container py-4">

    <!-- Control Panel -->
    <div class="d-flex gap-2 mb-4">
        <button data-bs-toggle="modal" data-bs-target="#prescribeTestsModal"
            id="btn-prescribe-tests" class="btn btn-primary shadow-sm">
            <i class="bi bi-speedometer2"></i>
            Prescribe Tests
        </button>

        <button class="btn btn-outline-primary"><i class="bi bi-gear"></i> Action 2</button>
        <button class="btn btn-secondary text-white"><i class="bi bi-sliders"></i> Action 3</button>
        <button class="btn btn-outline-secondary"><i class="bi bi-filter"></i> Action 4</button>
        <button class="btn btn-dark"><i class="bi bi-lightning-charge"></i> Action 5</button>
    </div>

    <!-- Back Button -->
    <div class="mb-3">
        <a href="@Url.Action("PatientManager", "DoctorPortal")" class="btn btn-outline-primary shadow-sm">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

        <!-- Header -->
        <div class="card-header text-white py-4 bg-primary bg-gradient">
            <h3 class="mb-0"><i class="bi bi-person-vcard"></i> Patient Profile</h3>
            <small class="opacity-75">Patient ID: @Model.PatientId</small>
        </div>

        <div class="card-body p-4">

            <!-- Identity Section -->
            <h5 class="fw-bold text-primary mb-3"><i class="bi bi-person-lines-fill"></i> Personal Information</h5>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="p-3 bg-light rounded border-start border-4 border-primary">
                        <label class="text-muted text-uppercase small fw-bold">Patient Code</label>
                        <p class="fw-semibold mb-0">@Model.PatientCode</p>
                    </div>
                </div>

                <div class="col-md-8">
                    <div class="p-3 bg-light rounded border-start border-4 border-primary">
                        <label class="text-muted text-uppercase small fw-bold">Full Name</label>
                        <p class="fw-semibold mb-0">@Model.FullName</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 bg-light rounded border-start border-4 border-primary">
                        <label class="text-muted text-uppercase small fw-bold">Gender</label>
                        <p class="fw-semibold mb-0">@Model.Gender</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 bg-light rounded border-start border-4 border-primary">
                        <label class="text-muted text-uppercase small fw-bold">Date of Birth</label>
                        <p class="fw-semibold mb-0">@Model.DateOfBirth.ToString("dd MMM yyyy")</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 bg-light rounded border-start border-4 border-primary">
                        <label class="text-muted text-uppercase small fw-bold">Blood Group</label>
                        <p class="badge bg-danger fs-6">@Model.BloodGroup</p>
                    </div>
                </div>
            </div>

            <hr />

            <!-- Contact Section -->
            <h5 class="fw-bold text-primary mb-3"><i class="bi bi-telephone-plus-fill"></i> Contact Information</h5>

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded border-start border-4 border-primary">
                        <label class="text-muted text-uppercase small fw-bold">Email Address</label>
                        <p class="fw-semibold mb-0"><a href="mailto:@Model.Email">@Model.Email</a></p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded border-start border-4 border-primary">
                        <label class="text-muted text-uppercase small fw-bold">Primary Contact</label>
                        <p class="fw-semibold mb-0"><a href="tel:@Model.ContactNumber">@Model.ContactNumber</a></p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded border-start border-4 border-primary">
                        <label class="text-muted text-uppercase small fw-bold">Alternate Contact</label>
                        <p class="fw-semibold mb-0">@Model.AlternateContactNumber</p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded border-start border-4 border-primary">
                        <label class="text-muted text-uppercase small fw-bold">Emergency Contact</label>
                        <p class="fw-semibold mb-0">
                            <strong>@Model.EmergencyContactName</strong><br />
                            <a href="tel:@Model.EmergencyContactNumber">@Model.EmergencyContactNumber</a><br />
                            <span class="small text-muted">@Model.RelationshipWithEmergencyContact</span>
                        </p>
                    </div>
                </div>
            </div>

            <hr />

            <!-- Address -->
            <h5 class="fw-bold text-primary mb-3"><i class="bi bi-geo-fill"></i> Address</h5>

            <div class="row g-4">

                <div class="col-md-12">
                    <div class="p-3 bg-light rounded border-start border-4 border-primary">
                        <label class="text-muted text-uppercase small fw-bold">Address</label>
                        <p class="fw-semibold mb-0">@Model.Address</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 bg-light rounded border-start border-4 border-primary">
                        <label class="text-muted text-uppercase small fw-bold">City</label>
                        <p class="fw-semibold mb-0">@Model.City</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 bg-light rounded border-start border-4 border-primary">
                        <label class="text-muted text-uppercase small fw-bold">State</label>
                        <p class="fw-semibold mb-0">@Model.State</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 bg-light rounded border-start border-4 border-primary">
                        <label class="text-muted text-uppercase small fw-bold">Zip Code</label>
                        <p class="fw-semibold mb-0">@Model.ZipCode</p>
                    </div>
                </div>
            </div>

            <hr />

            <!-- System Fields -->
            <h5 class="fw-bold text-primary mb-3"><i class="bi bi-clock-history"></i> System Information</h5>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded border-start border-4 border-primary">
                        <label class="text-muted text-uppercase small fw-bold">Created At</label>
                        <p class="fw-semibold mb-0">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded border-start border-4 border-primary">
                        <label class="text-muted text-uppercase small fw-bold">Updated At</label>
                        <p class="fw-semibold mb-0">@Model.UpdatedAt.ToString("dd MMM yyyy HH:mm")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Prescribe Tests Modal -->
<div class="modal fade" id="prescribeTestsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">

            <!-- Header -->
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Prescribe Lab Tests</h5>
                <button type="button" class="btn-close btn-close-white" id="btn-close-tests" data-bs-dismiss="modal"></button>
            </div>

            <!-- Body -->
            <div class="modal-body">
                <input id="patientId" type="hidden" name="name" value="@Model.PatientId" />

                <!-- Test List -->
                <label class="form-label fw-semibold">Select Laboratory Tests</label>
                <div id="testListContainer"
                     class="list-group mb-4 border rounded"
                     style="max-height: 300px; overflow-y: auto;">
                    <div class="p-2 text-muted small">Loading tests...</div>
                </div>

                <!-- Notes -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Notes (Optional)</label>
                    <textarea id="labRequestNotes" class="form-control" placeholder="Enter any remarks for laboratory staff"></textarea>
                </div>

            </div>

            <!-- Footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="btn-close-tests-2" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-success" id="btn-submit-tests">
                    Submit Request
                </button>
            </div>

        </div>
    </div>
</div>




@section Styles {

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />    
}

@section Scripts {
    <script src="~/js/DoctorPortal/ViewPatient.js"></script>
}
