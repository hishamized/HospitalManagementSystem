@model HMS.Application.DTO.DoctorPortal.ViewPatientDto

@{
    ViewData["Title"] = "Patient Details";
}

<div class="mx-auto max-w-7xl px-4 py-4">

    <!-- Control Panel -->
    <div class="mb-4 flex flex-wrap gap-2">
        <button id="btn-prescribe-tests" type="button"
                class="inline-flex items-center gap-2 rounded-lg bg-purple-600 px-4 py-2 text-white shadow-sm hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-purple-500"
                aria-controls="prescribeTestsModal" aria-expanded="false">
            <i class="fa-solid fa-gauge-high"></i>
            <span>Prescribe Tests</span>
        </button>

        <button id="btn-view-test-requests" type="button"
                class="inline-flex items-center gap-2 rounded-lg bg-indigo-500 px-4 py-2 text-white shadow-sm hover:bg-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-400">
            <i class="fa-solid fa-clipboard-list"></i>
            <span>View Test Requests</span>
        </button>

        <button type="button"
                class="inline-flex items-center gap-2 rounded-lg border border-purple-500 bg-transparent px-4 py-2 text-purple-200 hover:bg-purple-900/40">
            <i class="fa-solid fa-gear"></i>
            <span>Action 2</span>
        </button>

        <button type="button"
                class="inline-flex items-center gap-2 rounded-lg bg-gray-700 px-4 py-2 text-white hover:bg-gray-600">
            <i class="fa-solid fa-sliders"></i>
            <span>Action 3</span>
        </button>

        <button type="button"
                class="inline-flex items-center gap-2 rounded-lg border border-gray-600 bg-transparent px-4 py-2 text-gray-200 hover:bg-gray-800">
            <i class="fa-solid fa-filter"></i>
            <span>Action 4</span>
        </button>

        <button type="button"
                class="inline-flex items-center gap-2 rounded-lg bg-gray-900 px-4 py-2 text-white hover:bg-gray-800">
            <i class="fa-solid fa-bolt"></i>
            <span>Action 5</span>
        </button>
    </div>

    <!-- Back Button -->
    <div class="mb-3">
        <a href="@Url.Action("PatientManager", "DoctorPortal")"
           class="inline-flex items-center gap-2 rounded-lg border border-purple-500 px-4 py-2 text-purple-200 shadow-sm hover:bg-purple-900/40">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back</span>
        </a>
    </div>

    <div class="overflow-hidden rounded-2xl border border-gray-700 bg-gray-800 shadow-lg">

        <!-- Header -->
        <div class="bg-gradient-to-r from-purple-700 to-purple-600 px-6 py-4 text-white">
            <h3 class="mb-0 inline-flex items-center gap-2 text-lg font-semibold">
                <i class="fa-solid fa-id-card"></i>
                <span>Patient Profile</span>
            </h3>
            <div class="mt-1 text-sm text-gray-200/80">Patient ID: @Model.PatientId</div>
        </div>

        <div class="p-6">

            <!-- Identity Section -->
            <h5 class="mb-3 inline-flex items-center gap-2 font-bold text-purple-300">
                <i class="fa-solid fa-user"></i>
                <span>Personal Information</span>
            </h5>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-3">

                <div class="md:col-span-1">
                    <div class="rounded-lg border-l-4 border-purple-500 bg-gray-700 p-3">
                        <label class="block text-xs font-semibold uppercase text-gray-400">Patient Code</label>
                        <p class="mb-0 font-semibold text-gray-200">@Model.PatientCode</p>
                    </div>
                </div>

                <div class="md:col-span-2">
                    <div class="rounded-lg border-l-4 border-purple-500 bg-gray-700 p-3">
                        <label class="block text-xs font-semibold uppercase text-gray-400">Full Name</label>
                        <p class="mb-0 font-semibold text-gray-200">@Model.FullName</p>
                    </div>
                </div>

                <div class="md:col-span-1">
                    <div class="rounded-lg border-l-4 border-purple-500 bg-gray-700 p-3">
                        <label class="block text-xs font-semibold uppercase text-gray-400">Gender</label>
                        <p class="mb-0 font-semibold text-gray-200">@Model.Gender</p>
                    </div>
                </div>

                <div class="md:col-span-1">
                    <div class="rounded-lg border-l-4 border-purple-500 bg-gray-700 p-3">
                        <label class="block text-xs font-semibold uppercase text-gray-400">Date of Birth</label>
                        <p class="mb-0 font-semibold text-gray-200">@Model.DateOfBirth.ToString("dd MMM yyyy")</p>
                    </div>
                </div>

                <div class="md:col-span-1">
                    <div class="rounded-lg border-l-4 border-purple-500 bg-gray-700 p-3">
                        <label class="block text-xs font-semibold uppercase text-gray-400">Blood Group</label>
                        <p class="mb-0">
                            <span class="inline-block rounded bg-red-600 px-2 py-1 text-sm text-white">@Model.BloodGroup</span>
                        </p>
                    </div>
                </div>
            </div>

            <hr class="my-6 border-gray-700" />

            <!-- Contact Section -->
            <h5 class="mb-3 inline-flex items-center gap-2 font-bold text-purple-300">
                <i class="fa-solid fa-phone-plus"></i>
                <span>Contact Information</span>
            </h5>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">

                <div>
                    <div class="rounded-lg border-l-4 border-purple-500 bg-gray-700 p-3">
                        <label class="block text-xs font-semibold uppercase text-gray-400">Email Address</label>
                        <p class="mb-0 font-semibold text-gray-200">
                            <a href="mailto:@Model.Email" class="underline hover:text-purple-200">@Model.Email</a>
                        </p>
                    </div>
                </div>

                <div>
                    <div class="rounded-lg border-l-4 border-purple-500 bg-gray-700 p-3">
                        <label class="block text-xs font-semibold uppercase text-gray-400">Primary Contact</label>
                        <p class="mb-0 font-semibold text-gray-200">
                            <a href="tel:@Model.ContactNumber" class="underline hover:text-purple-200">@Model.ContactNumber</a>
                        </p>
                    </div>
                </div>

                <div>
                    <div class="rounded-lg border-l-4 border-purple-500 bg-gray-700 p-3">
                        <label class="block text-xs font-semibold uppercase text-gray-400">Alternate Contact</label>
                        <p class="mb-0 font-semibold text-gray-200">@Model.AlternateContactNumber</p>
                    </div>
                </div>

                <div>
                    <div class="rounded-lg border-l-4 border-purple-500 bg-gray-700 p-3">
                        <label class="block text-xs font-semibold uppercase text-gray-400">Emergency Contact</label>
                        <p class="mb-0 font-semibold text-gray-200">
                            <strong class="text-gray-100">@Model.EmergencyContactName</strong><br />
                            <a href="tel:@Model.EmergencyContactNumber" class="underline hover:text-purple-200">@Model.EmergencyContactNumber</a><br />
                            <span class="text-xs text-gray-400">@Model.RelationshipWithEmergencyContact</span>
                        </p>
                    </div>
                </div>
            </div>

            <hr class="my-6 border-gray-700" />

            <!-- Address -->
            <h5 class="mb-3 inline-flex items-center gap-2 font-bold text-purple-300">
                <i class="fa-solid fa-location-dot"></i>
                <span>Address</span>
            </h5>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-3">

                <div class="md:col-span-3">
                    <div class="rounded-lg border-l-4 border-purple-500 bg-gray-700 p-3">
                        <label class="block text-xs font-semibold uppercase text-gray-400">Address</label>
                        <p class="mb-0 font-semibold text-gray-200">@Model.Address</p>
                    </div>
                </div>

                <div>
                    <div class="rounded-lg border-l-4 border-purple-500 bg-gray-700 p-3">
                        <label class="block text-xs font-semibold uppercase text-gray-400">City</label>
                        <p class="mb-0 font-semibold text-gray-200">@Model.City</p>
                    </div>
                </div>

                <div>
                    <div class="rounded-lg border-l-4 border-purple-500 bg-gray-700 p-3">
                        <label class="block text-xs font-semibold uppercase text-gray-400">State</label>
                        <p class="mb-0 font-semibold text-gray-200">@Model.State</p>
                    </div>
                </div>

                <div>
                    <div class="rounded-lg border-l-4 border-purple-500 bg-gray-700 p-3">
                        <label class="block text-xs font-semibold uppercase text-gray-400">Zip Code</label>
                        <p class="mb-0 font-semibold text-gray-200">@Model.ZipCode</p>
                    </div>
                </div>
            </div>

            <hr class="my-6 border-gray-700" />

            <!-- System Fields -->
            <h5 class="mb-3 inline-flex items-center gap-2 font-bold text-purple-300">
                <i class="fa-solid fa-clock-rotate-left"></i>
                <span>System Information</span>
            </h5>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                <div>
                    <div class="rounded-lg border-l-4 border-purple-500 bg-gray-700 p-3">
                        <label class="block text-xs font-semibold uppercase text-gray-400">Created At</label>
                        <p class="mb-0 font-semibold text-gray-200">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</p>
                    </div>
                </div>

                <div>
                    <div class="rounded-lg border-l-4 border-purple-500 bg-gray-700 p-3">
                        <label class="block text-xs font-semibold uppercase text-gray-400">Updated At</label>
                        <p class="mb-0 font-semibold text-gray-200">@Model.UpdatedAt.ToString("dd MMM yyyy HH:mm")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Prescribe Tests Modal (Tailwind-ready; JS will toggle .hidden / aria-hidden) -->
<div id="prescribeTestsModal" class="fixed inset-0 z-50 flex hidden items-center justify-center" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="absolute inset-0 bg-black/60"></div>

    <div class="relative mx-4 w-full max-w-3xl">
        <div class="overflow-hidden rounded-lg border border-gray-700 bg-gray-800 shadow-lg">
            <!-- Header -->
            <div class="flex items-center justify-between bg-purple-700 px-4 py-3 text-white">
                <h5 class="text-lg font-semibold">Prescribe Lab Tests</h5>
                <button id="btn-close-tests" type="button" class="text-white hover:text-gray-200 focus:outline-none">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="p-4">
                <input id="patientId" type="hidden" name="name" value="@Model.PatientId" />

                <!-- Test List -->
                <label class="mb-2 block text-sm font-semibold text-gray-200">Select Laboratory Tests</label>
                <div id="testListContainer"
                     class="mb-4 overflow-y-auto rounded border border-gray-700"
                     style="max-height: 300px;">
                    <div class="p-2 text-sm text-gray-400">Loading tests...</div>
                </div>

                <!-- Notes -->
                <div class="mb-3">
                    <label class="mb-1 block text-sm font-semibold text-gray-200">Notes (Optional)</label>
                    <textarea id="labRequestNotes" class="min-h-[100px] w-full rounded border border-gray-700 bg-gray-900 px-3 py-2 text-gray-200" placeholder="Enter any remarks for laboratory staff"></textarea>
                </div>
            </div>

            <!-- Footer -->
            <div class="flex items-center justify-end gap-3 border-t border-gray-700 bg-gray-800 px-4 py-3">
                <button type="button" id="btn-close-tests-2" class="rounded bg-gray-700 px-4 py-2 text-white hover:bg-gray-600">Cancel</button>
                <button type="button" id="btn-submit-tests" class="rounded bg-green-600 px-4 py-2 text-white hover:bg-green-700">Submit Request</button>
            </div>
        </div>
    </div>
</div>

<!-- View Test Requests Modal -->
<div id="viewTestRequestsModal" class="fixed inset-0 z-50 flex hidden items-center justify-center" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="absolute inset-0 bg-black/60"></div>

    <div class="relative mx-4 w-full max-w-6xl">
        <div class="overflow-hidden rounded-lg border border-gray-700 bg-gray-800 shadow-lg">
            <div class="flex items-center justify-between bg-indigo-600 px-4 py-3 text-white">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-clipboard-list text-2xl"></i>
                    <div class="font-semibold">Patient Lab Test Requests</div>
                </div>
                <button onclick="hideModal(viewTestRequestsModal)" type="button" class="text-white hover:text-gray-200 focus:outline-none" id="btn-close-view-requests">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="bg-gray-800 px-0 pt-2">
                <div id="testRequestsGrid" class="w-full border-t border-gray-700" style="height: 520px;">
                    <!-- ag-grid or other grid will mount here -->
                </div>
            </div>

            <div class="flex items-center justify-between border-t border-gray-700 bg-gray-800 px-4 py-3">
                <small class="flex items-center gap-2 text-gray-400">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>Double-click a row to view more details</span>
                </small>

                <div class="flex items-center gap-2">
                    <button id="btn-export-requests" class="inline-flex items-center gap-2 rounded border border-purple-500 bg-transparent px-4 py-2 text-purple-200 hover:bg-purple-900/40">
                        <i class="fa-solid fa-download"></i>
                        <span>Export</span>
                    </button>

                    <button type="button" onclick="hideModal(viewTestRequestsModal)"  class="rounded bg-gray-700 px-4 py-2 text-white hover:bg-gray-600" id="btn-close-view-requests-2">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Update Status Modal -->
<div id="updateStatusModal" class="fixed inset-0 z-50 flex hidden items-center justify-center" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="absolute inset-0 bg-black/60"></div>

    <div class="relative mx-4 w-full max-w-md">
        <div class="overflow-hidden rounded-lg border border-gray-700 bg-gray-800 shadow-lg">
            <div class="flex items-center justify-between bg-purple-700 px-4 py-3 text-white">
                <h5 class="text-lg font-semibold">Update Lab Request Status</h5>
                <button onclick="hideModal(updateStatusModal)" type="button" class="text-white hover:text-gray-200 focus:outline-none" id="btn-close-update-status">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="p-4">
                <input type="hidden" id="us_LabRequestItemId" />
                <input type="hidden" id="us_LabRequestId" />
                <input type="hidden" id="us_LabTestId" />
                <input type="hidden" id="us_PatientId" />

                <div class="mb-3">
                    <label class="mb-1 block text-sm text-gray-200">Select New Status</label>
                    <select id="us_NewStatus" class="w-full rounded border border-gray-700 bg-gray-900 px-3 py-2 text-gray-200">
                        <option value="Pending">Pending</option>
                        <option value="Complete">Complete</option>
                        <option value="ResultAwaited">ResultAwaited</option>
                        <option value="Finished">Finished</option>
                        <option value="Cancelled">Cancelled</option>
                        <option value="Rejected">Rejected</option>
                    </select>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 border-t border-gray-700 bg-gray-800 px-4 py-3">
                <button onclick="hideModal(updateStatusModal)" class="rounded bg-gray-700 px-4 py-2 text-white hover:bg-gray-600" id="btn-close-update-status-2">Close</button>
                <button id="btn-save-status" class="rounded bg-green-600 px-4 py-2 text-white hover:bg-green-700">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <!-- Font Awesome (no Bootstrap icons) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="" crossorigin="anonymous" />
    <!-- Tailwind CSS is assumed to be included globally in your layout -->
}

@section Scripts {
    <script src="~/js/DoctorPortal/ViewPatient.js"></script>
}
