<div class="w-full bg-gray-900 border-b border-gray-800 text-gray-200">
    <div class="flex items-center justify-between px-4 h-16">

        <!-- LEFT: Logo + Menu Button -->
        <div class="flex items-center space-x-4">
            <!-- Mobile Menu Button -->
            <button @@click ="sidebarOpen = !sidebarOpen"
                    class="text-gray-300 hover:text-purple-400 focus:outline-none">
                <i class="bi bi-list text-2xl"></i>
            </button>

            <!-- Logo -->
            <a href="/" class="flex items-center">
                <img src="/images/logo-light.png" class="h-8" />
            </a>
        </div>

        <!-- CENTER: Search -->
        <div class="hidden lg:flex w-1/3">
            <div x-data="{open:false}" class="relative w-full">
                <input @@focus ="open=true"
                       @@click.outside ="open=false"
                       type="text"
                       placeholder="Search..."
                       class="w-full px-3 py-2 rounded-lg bg-gray-800 text-gray-200 border border-gray-700
                           focus:ring-2 focus:ring-purple-500 focus:outline-none" />

                <!-- Search dropdown -->
                <div x-show="open"
                     x-transition
                     class="absolute mt-2 w-full bg-gray-800 border border-gray-700 rounded-lg p-3 shadow-xl z-50">
                    <p class="text-sm text-gray-400 mb-2">Found 22 results</p>
                    <div class="space-y-1">
                        <a href="#" class="block px-2 py-1 rounded hover:bg-gray-700">Analytics Report</a>
                        <a href="#" class="block px-2 py-1 rounded hover:bg-gray-700">How can I help you?</a>
                        <a href="#" class="block px-2 py-1 rounded hover:bg-gray-700">User profile settings</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: Icons & User Menu -->
        <div class="flex items-center space-x-4">

            <!-- Notifications -->
            <div x-data="{open:false}" class="relative">
                <button @@click ="open=!open"
                        class="relative text-gray-300 hover:text-purple-400">
                    <i class="bi bi-bell text-xl"></i>
                    <span class="absolute -top-1 -right-1 bg-purple-600 text-white text-xs rounded-full px-1">9</span>
                </button>

                <div x-show="open"
                     x-transition
                     @@click.outside ="open=false"
                     class="absolute right-0 mt-2 w-72 bg-gray-800 border border-gray-700 rounded-lg shadow-xl z-50">
                    <div class="p-3 border-b border-gray-700 font-semibold">Notifications</div>
                    <div class="max-h-60 overflow-y-auto">
                        <a href="#" class="block px-3 py-2 hover:bg-gray-700">New message received</a>
                        <a href="#" class="block px-3 py-2 hover:bg-gray-700">User registered</a>
                        <a href="#" class="block px-3 py-2 hover:bg-gray-700">Server rebooted</a>
                    </div>
                    <div class="p-2 text-center border-t border-gray-700">
                        <a href="#" class="text-purple-400 hover:underline">View all</a>
                    </div>
                </div>
            </div>

            <!-- Language Selector -->
            <div x-data="{open:false}" class="relative">
                <button @@click ="open=!open" class="flex items-center text-gray-300 hover:text-purple-400">
                    <img src="/images/us.jpg" class="h-4 rounded" />
                </button>

                <div x-show="open"
                     @@click.outside ="open=false"
                     x-transition
                     class="absolute right-0 mt-2 w-40 bg-gray-800 border border-gray-700 rounded-lg shadow-xl z-50">
                    <form id="selectLanguage" method="post" asp-controller="Home" asp-action="SetLanguage">
                        <input id="culture" name="culture" type="hidden" />
                        <input id="returnUrl" name="returnUrl" type="hidden" value="/" />

                        <button type="button" onclick="changeLocale('en-US')" class="flex items-center px-3 py-2 hover:bg-gray-700">
                            <img src="/images/us.jpg" class="h-4 mr-2" /> English
                        </button>
                        <button type="button" onclick="changeLocale('hi-IN')" class="flex items-center px-3 py-2 hover:bg-gray-700">
                            <img src="/images/in.png" class="h-4 mr-2" /> Hindi
                        </button>
                        <button type="button" onclick="changeLocale('fr-FR')" class="flex items-center px-3 py-2 hover:bg-gray-700">
                            <img src="/images/fr.png" class="h-4 mr-2" /> French
                        </button>
                    </form>
                </div>
            </div>

            <!-- User Profile -->
            <div x-data="{open:false}" class="relative">
                <button @@click ="open=!open" class="flex items-center space-x-2 hover:text-purple-400">
                    <img src="/images/users/user-6.jpg" class="h-8 w-8 rounded-full" />
                    <span>Stanley</span>
                    <i class="bi bi-chevron-down"></i>
                </button>

                <div x-show="open"
                     x-transition
                     @@click.outside ="open=false"
                     class="absolute right-0 mt-2 w-48 bg-gray-800 border border-gray-700 rounded-lg shadow-xl z-50">
                    <div class="p-3 border-b border-gray-700">Welcome!</div>
                    <a href="#" class="block px-3 py-2 hover:bg-gray-700">My Account</a>
                    <a href="#" class="block px-3 py-2 hover:bg-gray-700">Settings</a>
                    <a href="#" class="block px-3 py-2 hover:bg-gray-700">Lock Screen</a>
                    <div class="border-t border-gray-700"></div>
                    <a href="#" class="block px-3 py-2 hover:bg-gray-700">Logout</a>
                </div>
            </div>

            <!-- Settings Icon -->
            <button class="text-gray-300 hover:text-purple-400"
                    @@click ="rightSidebarOpen = !rightSidebarOpen">
                <i class="bi bi-gear text-xl"></i>
            </button>
        </div>

    </div>
</div>
