<style>
    .sidebar-container{
        scrollbar-width: thin;
    }
    /* Custom Scrollbar for Sidebar - Chrome, Edge, Safari */
    .sidebar-container::-webkit-scrollbar {
        width: 6px; 
    }

    .sidebar-container::-webkit-scrollbar-track {
        background: #1f2937;
        border-radius: 10px;
    }

    .sidebar-container::-webkit-scrollbar-thumb {
        background: #9333ea;
        border-radius: 10px;
    }

        .sidebar-container::-webkit-scrollbar-thumb:hover {
            background: #a855f7;
        }

    /* Firefox scrollbar */
    .sidebar-container {
        scrollbar-width: thin;
        scrollbar-color: #9333ea #1f2937;
    }
</style>
<div x-data="{ sidebarVisible: true }" @@dblclick.window="if ($event.target.closest('.sidebar-container') === null) sidebarVisible = false">
    <div x-show="sidebarVisible"
         x-transition:leave="transition ease-in duration-300"
         x-transition:leave-start="opacity-100 translate-x-0"
         x-transition:leave-end="opacity-0 -translate-x-full"
         class="sidebar-container fixed left-0 top-0 z-10 h-screen w-64 overflow-y-auto bg-gray-900 text-gray-100 shadow-2xl"
         x-data="{
            openMenus: {},
            toggleMenu(menu) {
                this.openMenus[menu] = !this.openMenus[menu];
            },
            isOpen(menu) {
                return this.openMenus[menu] || false;
            }
         }">

        <!-- Hide Sidebar Button -->
        <div class="flex justify-end border-b border-gray-800 p-4">
            <button @@click="sidebarVisible = false"
                    class="rounded-lg p-2 text-gray-400 transition-colors hover:bg-gray-800 hover:text-purple-400"
                    title="Hide Sidebar">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>

        <!-- User Box -->
        <div class="border-b border-gray-800 p-6 text-center" x-data="{ userDropdown: false }">
            <img src="~/images/defaultPicture.png"
                 alt="user-img"
                 class="mx-auto h-20 w-20 rounded-full border-4 border-purple-600 shadow-lg">

            <div class="relative mt-4">
                <button @@click="userDropdown = !userDropdown"
                        class="text-lg font-semibold text-white transition-colors hover:text-purple-400">
                    @Context.Session.GetString("Username")
                    <i class="fas fa-chevron-down ml-1 text-xs"></i>
                </button>

                <div x-show="userDropdown"
                     @@click.away="userDropdown = false"
                     x-transition:enter="transition ease-out duration-200"
                     x-transition:enter-start="opacity-0 transform scale-95"
                     x-transition:enter-end="opacity-100 transform scale-100"
                     x-transition:leave="transition ease-in duration-150"
                     x-transition:leave-start="opacity-100 transform scale-100"
                     x-transition:leave-end="opacity-0 transform scale-95"
                     class="absolute left-0 right-0 z-50 mt-2 rounded-lg border border-gray-700 bg-gray-800 shadow-xl"
                     style="display: none;">

                    <a href="javascript:void(0);" class="flex items-center rounded-t-lg px-4 py-3 transition-colors hover:bg-purple-600">
                        <i class="fas fa-user mr-3 text-purple-400"></i>
                        <span>My Account</span>
                    </a>

                    <a href="javascript:void(0);" class="flex items-center px-4 py-3 transition-colors hover:bg-purple-600">
                        <i class="fas fa-cog mr-3 text-purple-400"></i>
                        <span>Settings</span>
                    </a>

                    <a href="javascript:void(0);" class="flex items-center px-4 py-3 transition-colors hover:bg-purple-600">
                        <i class="fas fa-lock mr-3 text-purple-400"></i>
                        <span>Lock Screen</span>
                    </a>

                    <a href="javascript:void(0);" class="flex items-center rounded-b-lg px-4 py-3 transition-colors hover:bg-purple-600">
                        <i class="fas fa-sign-out-alt mr-3 text-purple-400"></i>
                        <span>Logout</span>
                    </a>
                </div>
            </div>

            <p class="mt-2 text-sm text-gray-400">@Context.Session.GetString("Roles")</p>
        </div>

        <!-- Navigation Menu -->
        <nav class="py-4">
            <div class="mb-4 px-6">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500">Navigation</h3>
            </div>

            <!-- Main Menu -->
            <div class="mb-2">
                <button @@click="toggleMenu('mainDashboards')"
                        class="flex w-full items-center justify-between px-6 py-3 transition-colors hover:bg-gray-800">
                    <div class="flex items-center">
                        <i class="fas fa-home mr-3 text-lg text-purple-400"></i>
                        <span>Main Menu</span>
                    </div>
                    <div class="flex items-center">
                        <span class="mr-2 rounded-full bg-green-500 px-2 py-1 text-xs text-white">New</span>
                        <i class="fas fa-chevron-down transition-transform" :class="isOpen('mainDashboards') ? 'rotate-180' : ''"></i>
                    </div>
                </button>

                <div x-show="isOpen('mainDashboards')"
                     x-transition:enter="transition ease-out duration-200"
                     x-transition:enter-start="opacity-0 -translate-y-2"
                     x-transition:enter-end="opacity-100 translate-y-0"
                     class="bg-gray-800 bg-opacity-50"
                     style="display: none;">
                    @if (Context.Session.GetString("UserId") != null)
                    {
                        <form method="post" asp-controller="User" asp-action="Logout" class="block">
                            <button type="submit" class="w-full px-10 py-2 text-left text-sm transition-colors hover:bg-purple-600">
                                Logout
                            </button>
                        </form>
                        <a asp-controller="User" asp-action="Create"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Admins
                        </a>
                        <a asp-controller="Role" asp-action="Role"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Roles
                        </a>
                    }
                    else
                    {
                        <a asp-controller="User" asp-action="Login"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Login
                        </a>
                    }
                </div>
            </div>

            @if (Context.Session.GetString("UserId") != null)
            {
                <!-- Patients Menu -->
                <div class="mb-2">
                    <button @@click="toggleMenu('patients')"
                            class="flex w-full items-center justify-between px-6 py-3 transition-colors hover:bg-gray-800">
                        <div class="flex items-center">
                            <i class="fas fa-users mr-3 text-lg text-purple-400"></i>
                            <span>Patients</span>
                        </div>
                        <div class="flex items-center">
                            <span class="mr-2 rounded-full bg-green-500 px-2 py-1 text-xs text-white">3</span>
                            <i class="fas fa-chevron-down transition-transform" :class="isOpen('patients') ? 'rotate-180' : ''"></i>
                        </div>
                    </button>

                    <div x-show="isOpen('patients')"
                         x-transition
                         class="bg-gray-800 bg-opacity-50"
                         style="display: none;">
                        <a asp-controller="Patient" asp-action="Patients"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            View Patients
                        </a>
                        <a asp-controller="PatientVisit" asp-action="PatientVisits"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Manage Visits
                        </a>
                        <a asp-controller="Appointment" asp-action="Appointment"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Appointments
                        </a>
                    </div>
                </div>

                <!-- Doctors Menu -->
                <div class="mb-2">
                    <button @@click="toggleMenu('doctors')"
                            class="flex w-full items-center justify-between px-6 py-3 transition-colors hover:bg-gray-800">
                        <div class="flex items-center">
                            <i class="fas fa-user-md mr-3 text-lg text-purple-400"></i>
                            <span>Doctors</span>
                        </div>
                        <div class="flex items-center">
                            <span class="mr-2 rounded-full bg-green-500 px-2 py-1 text-xs text-white">6</span>
                            <i class="fas fa-chevron-down transition-transform" :class="isOpen('doctors') ? 'rotate-180' : ''"></i>
                        </div>
                    </button>

                    <div x-show="isOpen('doctors')"
                         x-transition
                         class="bg-gray-800 bg-opacity-50"
                         style="display: none;">
                        <a asp-controller="Doctor" asp-action="Doctor"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Doctors
                        </a>
                        <a asp-controller="Doctor" asp-action="Availability"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Check Doctor Availability
                        </a>
                        <a asp-controller="Department" asp-action="Department"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Departments
                        </a>
                        <a asp-controller="Slot" asp-action="Slot"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Slots
                        </a>
                        <a asp-controller="DoctorDocument" asp-action="Document"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Doctor Documents
                        </a>
                        <a asp-controller="DoctorDocument" asp-action="ViewDocument"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            View Doctor Documents
                        </a>
                    </div>
                </div>

                <!-- Wards Menu -->
                <div class="mb-2">
                    <button @@click="toggleMenu('wards')"
                            class="flex w-full items-center justify-between px-6 py-3 transition-colors hover:bg-gray-800">
                        <div class="flex items-center">
                            <i class="fas fa-hospital mr-3 text-lg text-purple-400"></i>
                            <span>Wards</span>
                        </div>
                        <div class="flex items-center">
                            <span class="mr-2 rounded-full bg-green-500 px-2 py-1 text-xs text-white">2</span>
                            <i class="fas fa-chevron-down transition-transform" :class="isOpen('wards') ? 'rotate-180' : ''"></i>
                        </div>
                    </button>

                    <div x-show="isOpen('wards')"
                         x-transition
                         class="bg-gray-800 bg-opacity-50"
                         style="display: none;">
                        <a asp-controller="Ward" asp-action="Ward"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Wards
                        </a>
                        <a asp-controller="Ward" asp-action="Assignment"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Assign Doctor To Wards
                        </a>
                    </div>
                </div>

                <!-- Feedback Menu -->
                <div class="mb-2">
                    <button @@click="toggleMenu('feedback')"
                            class="flex w-full items-center justify-between px-6 py-3 transition-colors hover:bg-gray-800">
                        <div class="flex items-center">
                            <i class="fas fa-comments mr-3 text-lg text-purple-400"></i>
                            <span>Feedback</span>
                        </div>
                        <div class="flex items-center">
                            <span class="mr-2 rounded-full bg-green-500 px-2 py-1 text-xs text-white">2</span>
                            <i class="fas fa-chevron-down transition-transform" :class="isOpen('feedback') ? 'rotate-180' : ''"></i>
                        </div>
                    </button>

                    <div x-show="isOpen('feedback')"
                         x-transition
                         class="bg-gray-800 bg-opacity-50"
                         style="display: none;">
                        <a asp-controller="Feedback" asp-action="Index"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Give Feedback To Doctor
                        </a>
                        <a asp-controller="Feedback" asp-action="CheckFeedback"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Check Doctor Feedback
                        </a>
                    </div>
                </div>

                <!-- Beds Menu -->
                <div class="mb-2">
                    <button @@click="toggleMenu('beds')"
                            class="flex w-full items-center justify-between px-6 py-3 transition-colors hover:bg-gray-800">
                        <div class="flex items-center">
                            <i class="fas fa-bed mr-3 text-lg text-purple-400"></i>
                            <span>Beds</span>
                        </div>
                        <div class="flex items-center">
                            <span class="mr-2 rounded-full bg-green-500 px-2 py-1 text-xs text-white">1</span>
                            <i class="fas fa-chevron-down transition-transform" :class="isOpen('beds') ? 'rotate-180' : ''"></i>
                        </div>
                    </button>

                    <div x-show="isOpen('beds')"
                         x-transition
                         class="bg-gray-800 bg-opacity-50"
                         style="display: none;">
                        <a asp-controller="Bed" asp-action="Index"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Bed Management
                        </a>
                    </div>
                </div>

                <!-- Chats Menu -->
                <div class="mb-2">
                    <button @@click="toggleMenu('chats')"
                            class="flex w-full items-center justify-between px-6 py-3 transition-colors hover:bg-gray-800">
                        <div class="flex items-center">
                            <i class="fas fa-comment-dots mr-3 text-lg text-purple-400"></i>
                            <span>Chats</span>
                        </div>
                        <div class="flex items-center">
                            <span class="mr-2 rounded-full bg-green-500 px-2 py-1 text-xs text-white">1</span>
                            <i class="fas fa-chevron-down transition-transform" :class="isOpen('chats') ? 'rotate-180' : ''"></i>
                        </div>
                    </button>

                    <div x-show="isOpen('chats')"
                         x-transition
                         class="bg-gray-800 bg-opacity-50"
                         style="display: none;">
                        <a asp-controller="Chats" asp-action="Chats"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Chats
                        </a>
                    </div>
                </div>

                <!-- Tests Menu -->
                <div class="mb-2">
                    <button @@click="toggleMenu('tests')"
                            class="flex w-full items-center justify-between px-6 py-3 transition-colors hover:bg-gray-800">
                        <div class="flex items-center">
                            <i class="fas fa-flask mr-3 text-lg text-purple-400"></i>
                            <span>Tests (Core)</span>
                        </div>
                        <div class="flex items-center">
                            <span class="mr-2 rounded-full bg-green-500 px-2 py-1 text-xs text-white">2</span>
                            <i class="fas fa-chevron-down transition-transform" :class="isOpen('tests') ? 'rotate-180' : ''"></i>
                        </div>
                    </button>

                    <div x-show="isOpen('tests')"
                         x-transition
                         class="bg-gray-800 bg-opacity-50"
                         style="display: none;">
                        <a asp-controller="Lab" asp-action="ManageTestsCore"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Manage Tests
                        </a>
                    </div>
                </div>
            }

            <!-- Doctor Portal -->
            <div class="mb-2">
                <button @@click="toggleMenu('doctorPortal')"
                        class="flex w-full items-center justify-between px-6 py-3 transition-colors hover:bg-gray-800">
                    <div class="flex items-center">
                        <i class="fas fa-stethoscope mr-3 text-lg text-purple-400"></i>
                        <span>Doctor Portal</span>
                    </div>
                    <div class="flex items-center">
                        <span class="mr-2 rounded-full bg-green-500 px-2 py-1 text-xs text-white">2</span>
                        <i class="fas fa-chevron-down transition-transform" :class="isOpen('doctorPortal') ? 'rotate-180' : ''"></i>
                    </div>
                </button>

                <div x-show="isOpen('doctorPortal')"
                     x-transition
                     class="bg-gray-800 bg-opacity-50"
                     style="display: none;">
                    @if (Context.Session.GetString("DoctorId") != null)
                    {
                        <a asp-controller="DoctorPortal" asp-action="PatientManager"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Patient Manager
                        </a>
                        <form asp-controller="DoctorPortal" asp-action="Logout" method="post" class="block">
                            <button type="submit" class="w-full px-10 py-2 text-left text-sm transition-colors hover:bg-purple-600">
                                Logout (@Context.Session.GetString("FirstName"))
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="DoctorPortal" asp-action="LoginPage"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Login (Doctor)
                        </a>
                    }
                </div>
            </div>

            <!-- Analytics -->
            <div class="mb-2">
                <button @@click="toggleMenu('analytics')"
                        class="flex w-full items-center justify-between px-6 py-3 transition-colors hover:bg-gray-800">
                    <div class="flex items-center">
                        <i class="fas fa-chart-line mr-3 text-lg text-purple-400"></i>
                        <span>Analytics</span>
                    </div>
                    <div class="flex items-center">
                        <span class="mr-2 rounded-full bg-green-500 px-2 py-1 text-xs text-white">4</span>
                        <i class="fas fa-chevron-down transition-transform" :class="isOpen('analytics') ? 'rotate-180' : ''"></i>
                    </div>
                </button>

                <div x-show="isOpen('analytics')"
                     x-transition
                     class="bg-gray-800 bg-opacity-50"
                     style="display: none;">
                    <a asp-controller="Analytics" asp-action="Analytics"
                       class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                        Analytics Dashboard
                    </a>
                </div>
            </div>

            <!-- Patients Portal -->
            <div class="mb-2">
                <button @@click="toggleMenu('patientsPortal')"
                        class="flex w-full items-center justify-between px-6 py-3 transition-colors hover:bg-gray-800">
                    <div class="flex items-center">
                        <i class="fas fa-user-injured mr-3 text-lg text-purple-400"></i>
                        <span>Patients Portal</span>
                    </div>
                    <div class="flex items-center">
                        <span class="mr-2 rounded-full bg-green-500 px-2 py-1 text-xs text-white">2</span>
                        <i class="fas fa-chevron-down transition-transform" :class="isOpen('patientsPortal') ? 'rotate-180' : ''"></i>
                    </div>
                </button>

                <div x-show="isOpen('patientsPortal')"
                     x-transition
                     class="bg-gray-800 bg-opacity-50"
                     style="display: none;">
                    <a asp-controller="PatientPortal" asp-action="PatientPortal"
                       class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                        Patients
                    </a>
                    @if (Context.Session.GetString("PatientId") == null)
                    {
                        <a asp-controller="PatientPortal" asp-action="LoginPage"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Patient Login
                        </a>
                    }
                </div>
            </div>

            <!-- Patient Menu (Conditional) -->
            @if (Context.Session.GetString("PatientId") != null)
            {
                <div class="mb-2">
                    <button @@click="toggleMenu('patientMenu')"
                            class="flex w-full items-center justify-between px-6 py-3 transition-colors hover:bg-gray-800">
                        <div class="flex items-center">
                            <i class="fas fa-user-cog mr-3 text-lg text-purple-400"></i>
                            <span>Patient Menu</span>
                        </div>
                        <div class="flex items-center">
                            <span class="mr-2 rounded-full bg-green-500 px-2 py-1 text-xs text-white">2</span>
                            <i class="fas fa-chevron-down transition-transform" :class="isOpen('patientMenu') ? 'rotate-180' : ''"></i>
                        </div>
                    </button>

                    <div x-show="isOpen('patientMenu')"
                         x-transition
                         class="bg-gray-800 bg-opacity-50"
                         style="display: none;">
                        <form asp-controller="PatientPortal" asp-action="Logout" method="post" class="block">
                            <button type="submit" class="w-full px-10 py-2 text-left text-sm transition-colors hover:bg-purple-600">
                                Logout (@Context.Session.GetString("FullName"))
                            </button>
                        </form>
                        <a asp-controller="PatientPortal" asp-action="ViewManageVisits"
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Manage Visits
                        </a>
                        <a asp-controller="" asp-action=""
                           class="block px-10 py-2 text-sm transition-colors hover:bg-purple-600">
                            Patient Portal Option 2
                        </a>
                    </div>
                </div>
            }
        </nav>
    </div>

    <!-- Toggle Button (appears when sidebar is hidden) -->
    <button x-show="!sidebarVisible"
            @@click="sidebarVisible = true"
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            class="fixed left-4 top-4 z-50 rounded-lg bg-purple-600 p-3 text-white shadow-lg transition-colors hover:bg-purple-700">
        <i class="fas fa-bars text-2xl"></i>
    </button>
</div>