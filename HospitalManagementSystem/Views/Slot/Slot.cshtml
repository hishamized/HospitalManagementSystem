@{
    ViewData["Title"] = "Slot Management";
}

<div class="min-h-screen bg-gray-900 p-6">
    <div class="max-w-7xl mx-auto">
        <div class="bg-gray-800 rounded-2xl shadow-2xl border border-gray-700 overflow-hidden">
            <!-- Header -->
            <div class="bg-gray-800 border-b border-gray-700 px-6 py-4">
                <div class="flex items-center justify-between">
                    <h4 class="text-2xl font-bold text-purple-400 flex items-center gap-2">
                        <i class="fas fa-clock"></i>
                        Slot Management
                    </h4>
                    <button class="bg-gradient-to-r from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 text-white font-semibold px-4 py-2 rounded-lg shadow-lg transition-all flex items-center gap-2"
                            id="btnAddSlot">
                        <i class="fas fa-plus-circle"></i>
                        Add Slot
                    </button>
                </div>
            </div>

            <!-- Grid Body -->
            <div class="p-6">
                <div id="slotsGrid" class="ag-theme-alpine-dark" style="height: 600px; width: 100%;"></div>
            </div>
        </div>
    </div>
</div>

<!-- Add Slot Modal -->
<div class="fixed inset-0 bg-black/60 flex items-center justify-center p-4 z-50 hidden"
     id="addSlotModal"
     tabindex="-1">
    <div class="bg-gray-800 rounded-2xl shadow-2xl border border-gray-700 w-full max-w-lg transform transition-all max-h-[90vh] overflow-y-auto">
        <!-- Modal Header -->
        <div class="bg-purple-600 px-6 py-4 flex items-center justify-between rounded-t-2xl sticky top-0 z-10">
            <h5 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fas fa-plus-circle"></i>
                Add Slot
            </h5>
            <button type="button"
                    class="text-white hover:text-gray-200 text-2xl transition-colors"
                    onclick="document.getElementById('addSlotModal').classList.add('hidden')">
                &times;
            </button>
        </div>

        <!-- Modal Body -->
        <form id="addSlotForm">
            <div class="p-6 space-y-4">
                <!-- Reporting Time -->
                <div>
                    <label for="ReportingTime" class="block text-gray-300 font-semibold mb-2">
                        <i class="fas fa-sign-in-alt text-purple-400 mr-2"></i>Reporting Time
                    </label>
                    <input type="time"
                           class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                           id="ReportingTime"
                           name="ReportingTime"
                           required>
                    <div class="text-red-400 text-sm mt-1 hidden" id="ReportingTime_error"></div>
                </div>

                <!-- Leaving Time -->
                <div>
                    <label for="LeavingTime" class="block text-gray-300 font-semibold mb-2">
                        <i class="fas fa-sign-out-alt text-purple-400 mr-2"></i>Leaving Time
                    </label>
                    <input type="time"
                           class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                           id="LeavingTime"
                           name="LeavingTime"
                           required>
                    <div class="text-red-400 text-sm mt-1 hidden" id="LeavingTime_error"></div>
                </div>

                <!-- Days of Week -->
                <div>
                    <label class="block text-gray-300 font-semibold mb-3">
                        <i class="fas fa-calendar-week text-purple-400 mr-2"></i>Days of Week
                    </label>
                    <div class="space-y-2">
                        <label class="flex items-center gap-3 p-3 bg-gray-700 rounded-lg hover:bg-gray-600 transition-colors cursor-pointer">
                            <input class="day-checkbox w-5 h-5 rounded bg-gray-600 border-gray-500 text-purple-600 focus:ring-purple-500 focus:ring-2"
                                   type="checkbox" value="1" id="Sunday">
                            <span class="text-gray-300">Sunday</span>
                        </label>
                        <label class="flex items-center gap-3 p-3 bg-gray-700 rounded-lg hover:bg-gray-600 transition-colors cursor-pointer">
                            <input class="day-checkbox w-5 h-5 rounded bg-gray-600 border-gray-500 text-purple-600 focus:ring-purple-500 focus:ring-2"
                                   type="checkbox" value="2" id="Monday">
                            <span class="text-gray-300">Monday</span>
                        </label>
                        <label class="flex items-center gap-3 p-3 bg-gray-700 rounded-lg hover:bg-gray-600 transition-colors cursor-pointer">
                            <input class="day-checkbox w-5 h-5 rounded bg-gray-600 border-gray-500 text-purple-600 focus:ring-purple-500 focus:ring-2"
                                   type="checkbox" value="4" id="Tuesday">
                            <span class="text-gray-300">Tuesday</span>
                        </label>
                        <label class="flex items-center gap-3 p-3 bg-gray-700 rounded-lg hover:bg-gray-600 transition-colors cursor-pointer">
                            <input class="day-checkbox w-5 h-5 rounded bg-gray-600 border-gray-500 text-purple-600 focus:ring-purple-500 focus:ring-2"
                                   type="checkbox" value="8" id="Wednesday">
                            <span class="text-gray-300">Wednesday</span>
                        </label>
                        <label class="flex items-center gap-3 p-3 bg-gray-700 rounded-lg hover:bg-gray-600 transition-colors cursor-pointer">
                            <input class="day-checkbox w-5 h-5 rounded bg-gray-600 border-gray-500 text-purple-600 focus:ring-purple-500 focus:ring-2"
                                   type="checkbox" value="16" id="Thursday">
                            <span class="text-gray-300">Thursday</span>
                        </label>
                        <label class="flex items-center gap-3 p-3 bg-gray-700 rounded-lg hover:bg-gray-600 transition-colors cursor-pointer">
                            <input class="day-checkbox w-5 h-5 rounded bg-gray-600 border-gray-500 text-purple-600 focus:ring-purple-500 focus:ring-2"
                                   type="checkbox" value="32" id="Friday">
                            <span class="text-gray-300">Friday</span>
                        </label>
                        <label class="flex items-center gap-3 p-3 bg-gray-700 rounded-lg hover:bg-gray-600 transition-colors cursor-pointer">
                            <input class="day-checkbox w-5 h-5 rounded bg-gray-600 border-gray-500 text-purple-600 focus:ring-purple-500 focus:ring-2"
                                   type="checkbox" value="64" id="Saturday">
                            <span class="text-gray-300">Saturday</span>
                        </label>
                    </div>
                    <div class="text-red-400 text-sm mt-2 hidden" id="DaysOfWeek_error"></div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="bg-gray-800 border-t border-gray-700 px-6 py-4 flex items-center justify-end gap-3 rounded-b-2xl sticky bottom-0">
                <button type="button"
                        class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-gray-300 font-semibold rounded-lg transition-colors"
                        onclick="document.getElementById('addSlotModal').classList.add('hidden')">
                    Cancel
                </button>
                <button type="submit"
                        class="px-4 py-2 bg-gradient-to-r from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 text-white font-semibold rounded-lg shadow-lg transition-all"
                        id="btnSaveSlot">
                    Save Slot
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Slot Modal -->
<div class="fixed inset-0 bg-black/60 flex items-center justify-center p-4 z-50 hidden"
     id="editSlotModal"
     tabindex="-1">
    <div class="bg-gray-800 rounded-2xl shadow-2xl border border-gray-700 w-full max-w-lg transform transition-all max-h-[90vh] overflow-y-auto">
        <!-- Modal Header -->
        <div class="bg-purple-600 px-6 py-4 flex items-center justify-between rounded-t-2xl sticky top-0 z-10">
            <h5 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fas fa-edit"></i>
                Edit Slot
            </h5>
            <button type="button"
                    class="text-white hover:text-gray-200 text-2xl transition-colors"
                    onclick="document.getElementById('editSlotModal').classList.add('hidden')">
                &times;
            </button>
        </div>

        <!-- Modal Body -->
        <form id="editSlotForm">
            <div class="p-6 space-y-4">
                <input type="hidden" id="editSlotId" />

                <!-- Reporting Time -->
                <div>
                    <label for="editReportingTime" class="block text-gray-300 font-semibold mb-2">
                        <i class="fas fa-sign-in-alt text-purple-400 mr-2"></i>Reporting Time
                    </label>
                    <input type="time"
                           class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                           id="editReportingTime"
                           required>
                    <div class="text-red-400 text-sm mt-1 hidden" id="editReportingTime_error"></div>
                </div>

                <!-- Leaving Time -->
                <div>
                    <label for="editLeavingTime" class="block text-gray-300 font-semibold mb-2">
                        <i class="fas fa-sign-out-alt text-purple-400 mr-2"></i>Leaving Time
                    </label>
                    <input type="time"
                           class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                           id="editLeavingTime"
                           required>
                    <div class="text-red-400 text-sm mt-1 hidden" id="editLeavingTime_error"></div>
                </div>

                <!-- Days of Week -->
                <div>
                    <label class="block text-gray-300 font-semibold mb-3">
                        <i class="fas fa-calendar-week text-purple-400 mr-2"></i>Days of Week
                    </label>
                    <div class="grid grid-cols-2 gap-2">
                        <label class="flex items-center gap-3 p-3 bg-gray-700 rounded-lg hover:bg-gray-600 transition-colors cursor-pointer">
                            <input class="edit-day-checkbox w-5 h-5 rounded bg-gray-600 border-gray-500 text-purple-600 focus:ring-purple-500 focus:ring-2"
                                   type="checkbox" id="editSunday" value="1">
                            <span class="text-gray-300">Sunday</span>
                        </label>
                        <label class="flex items-center gap-3 p-3 bg-gray-700 rounded-lg hover:bg-gray-600 transition-colors cursor-pointer">
                            <input class="edit-day-checkbox w-5 h-5 rounded bg-gray-600 border-gray-500 text-purple-600 focus:ring-purple-500 focus:ring-2"
                                   type="checkbox" id="editMonday" value="2">
                            <span class="text-gray-300">Monday</span>
                        </label>
                        <label class="flex items-center gap-3 p-3 bg-gray-700 rounded-lg hover:bg-gray-600 transition-colors cursor-pointer">
                            <input class="edit-day-checkbox w-5 h-5 rounded bg-gray-600 border-gray-500 text-purple-600 focus:ring-purple-500 focus:ring-2"
                                   type="checkbox" id="editTuesday" value="4">
                            <span class="text-gray-300">Tuesday</span>
                        </label>
                        <label class="flex items-center gap-3 p-3 bg-gray-700 rounded-lg hover:bg-gray-600 transition-colors cursor-pointer">
                            <input class="edit-day-checkbox w-5 h-5 rounded bg-gray-600 border-gray-500 text-purple-600 focus:ring-purple-500 focus:ring-2"
                                   type="checkbox" id="editWednesday" value="8">
                            <span class="text-gray-300">Wednesday</span>
                        </label>
                        <label class="flex items-center gap-3 p-3 bg-gray-700 rounded-lg hover:bg-gray-600 transition-colors cursor-pointer">
                            <input class="edit-day-checkbox w-5 h-5 rounded bg-gray-600 border-gray-500 text-purple-600 focus:ring-purple-500 focus:ring-2"
                                   type="checkbox" id="editThursday" value="16">
                            <span class="text-gray-300">Thursday</span>
                        </label>
                        <label class="flex items-center gap-3 p-3 bg-gray-700 rounded-lg hover:bg-gray-600 transition-colors cursor-pointer">
                            <input class="edit-day-checkbox w-5 h-5 rounded bg-gray-600 border-gray-500 text-purple-600 focus:ring-purple-500 focus:ring-2"
                                   type="checkbox" id="editFriday" value="32">
                            <span class="text-gray-300">Friday</span>
                        </label>
                        <label class="flex items-center gap-3 p-3 bg-gray-700 rounded-lg hover:bg-gray-600 transition-colors cursor-pointer">
                            <input class="edit-day-checkbox w-5 h-5 rounded bg-gray-600 border-gray-500 text-purple-600 focus:ring-purple-500 focus:ring-2"
                                   type="checkbox" id="editSaturday" value="64">
                            <span class="text-gray-300">Saturday</span>
                        </label>
                    </div>
                    <div class="text-red-400 text-sm mt-2 hidden" id="editDaysOfWeek_error"></div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="bg-gray-800 border-t border-gray-700 px-6 py-4 flex items-center justify-end gap-3 rounded-b-2xl sticky bottom-0">
                <button type="button"
                        class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-gray-300 font-semibold rounded-lg transition-colors"
                        onclick="document.getElementById('editSlotModal').classList.add('hidden')">
                    Cancel
                </button>
                <button type="submit"
                        class="px-4 py-2 bg-gradient-to-r from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 text-white font-semibold rounded-lg shadow-lg transition-all">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <!-- AG Grid CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@31.0.1/styles/ag-grid.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@31.0.1/styles/ag-theme-alpine.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* AG Grid Dark Theme Customization */
        .ag-theme-alpine-dark {
            --ag-background-color: #1f2937;
            --ag-header-background-color: #374151;
            --ag-odd-row-background-color: #1f2937;
            --ag-row-hover-color: #374151;
            --ag-foreground-color: #e5e7eb;
            --ag-border-color: #4b5563;
            --ag-header-foreground-color: #a78bfa;
        }

            /* Custom scrollbar for dark theme */
            .ag-theme-alpine-dark ::-webkit-scrollbar {
                width: 8px;
                height: 8px;
            }

            .ag-theme-alpine-dark ::-webkit-scrollbar-track {
                background: #1f2937;
            }

            .ag-theme-alpine-dark ::-webkit-scrollbar-thumb {
                background: #6b7280;
                border-radius: 4px;
            }

                .ag-theme-alpine-dark ::-webkit-scrollbar-thumb:hover {
                    background: #9333ea;
                }
    </style>
}

@section Scripts {
    <!-- AG Grid JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/ag-grid-community@31.0.1/dist/ag-grid-community.min.js"></script>
    <script>
        window.showModal = (id) => document.getElementById(id).classList.remove("hidden");
        window.hideModal = (id) => document.getElementById(id).classList.add("hidden");
    </script>
    <script src="~/js/Slot/slot.js"></script>
}