<!-- Modern, enterprise-grade rewrite of your Analytics Dashboard
     Clean, minimal, professional — dark + purple theme preserved
     Over-the-top neon effects removed; replaced with subtle UI polish
-->
@{
    ViewData["Title"] = "Analytics Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bgColorOverRide min-h-screen bg-purple-700/20 px-6 py-10">
    <div class="max-w-7xl mx-auto space-y-10">
        <!-- HEADER -->
        <header class="space-y-2 text-center">
            <h1 class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-purple-400 to-purple-600 bg-clip-text text-transparent">
                Analytics Dashboard
            </h1>
            <p class="text-gray-400 text-lg">Real-time operational insights for smart decision making</p>
        </header>

        <!-- SUMMARY CARDS (Professional + Minimal) -->
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

            <!-- Card Template (refined and minimal) -->
            <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6 shadow-lg hover:shadow-purple-900/20 transition">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <div class="p-3 rounded-xl bg-purple-700/20 text-purple-300">
                            <i class="fas fa-users text-2xl"></i>
                        </div>
                        <div>
                            <p class="text-gray-400 text-sm">Total Patients</p>
                            <h3 id="totalPatients" class="text-3xl font-bold text-white">0</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6 shadow-lg hover:shadow-purple-900/20 transition">
                <div class="flex items-center gap-4">
                    <div class="p-3 rounded-xl bg-purple-700/20 text-purple-300">
                        <i class="fas fa-user-md text-2xl"></i>
                    </div>
                    <div>
                        <p class="text-gray-400 text-sm">Total Doctors</p>
                        <h3 id="totalDoctors" class="text-3xl font-bold text-white">0</h3>
                    </div>
                </div>
            </div>

            <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6 shadow-lg hover:shadow-purple-900/20 transition">
                <div class="flex items-center gap-4">
                    <div class="p-3 rounded-xl bg-purple-700/20 text-purple-300">
                        <i class="fas fa-calendar-check text-2xl"></i>
                    </div>
                    <div>
                        <p class="text-gray-400 text-sm">Appointments</p>
                        <h3 id="totalAppointments" class="text-3xl font-bold text-white">0</h3>
                    </div>
                </div>
            </div>

            <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6 shadow-lg hover:shadow-purple-900/20 transition">
                <div class="flex items-center gap-4">
                    <div class="p-3 rounded-xl bg-purple-700/20 text-purple-300">
                        <i class="fas fa-building text-2xl"></i>
                    </div>
                    <div>
                        <p class="text-gray-400 text-sm">Departments</p>
                        <h3 id="totalDepartments" class="text-3xl font-bold text-white">0</h3>
                    </div>
                </div>
            </div>

        </section>

        <!-- CHARTS SECTION -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="bg-gray-900 border border-gray-800 rounded-2xl shadow-lg overflow-hidden">
                <header class="px-6 py-4 border-b border-gray-800 bg-gray-850 flex items-center gap-3">
                    <i class="fas fa-chart-line text-purple-400 text-xl"></i>
                    <h2 class="text-xl font-semibold text-white">Appointments Over Time</h2>
                </header>
                <div class="p-6">
                    <canvas id="appointmentsChart" class="max-h-80"></canvas>
                </div>
            </div>

            <div class="bg-gray-900 border border-gray-800 rounded-2xl shadow-lg overflow-hidden">
                <header class="px-6 py-4 border-b border-gray-800 bg-gray-850 flex items-center gap-3">
                    <i class="fas fa-user-plus text-purple-400 text-xl"></i>
                    <h2 class="text-xl font-semibold text-white">Patient Registrations</h2>
                </header>
                <div class="p-6">
                    <canvas id="patientsChart" class="max-h-80"></canvas>
                </div>
            </div>
        </section>

        <!-- DISTRIBUTION CHARTS -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="bg-gray-900 border border-gray-800 rounded-2xl shadow-lg overflow-hidden">
                <header class="px-6 py-4 border-b border-gray-800 bg-gray-850 flex items-center gap-3">
                    <i class="fas fa-chart-pie text-purple-400 text-xl"></i>
                    <h2 class="text-xl font-semibold text-white">Department Distribution</h2>
                </header>
                <div class="p-6">
                    <canvas id="departmentChart" class="max-h-80"></canvas>
                </div>
            </div>

            <div class="bg-gray-900 border border-gray-800 rounded-2xl shadow-lg overflow-hidden">
                <header class="px-6 py-4 border-b border-gray-800 bg-gray-850 flex items-center gap-3">
                    <i class="fas fa-venus-mars text-purple-400 text-xl"></i>
                    <h2 class="text-xl font-semibold text-white">Gender Distribution</h2>
                </header>
                <div class="p-6">
                    <canvas id="genderChart" class="max-h-80"></canvas>
                </div>
            </div>
        </section>

        <!-- LIST DATA (Top Doctors / Expiring Insurance) -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="bg-gray-900 border border-gray-800 rounded-2xl shadow-lg overflow-hidden">
                <header class="px-6 py-4 border-b border-gray-800 bg-gray-850 flex items-center gap-3">
                    <i class="fas fa-trophy text-purple-400 text-xl"></i>
                    <h2 class="text-xl font-semibold text-white">Top Doctors by Appointments</h2>
                </header>
                <div class="p-6 max-h-96 overflow-y-auto custom-scrollbar">
                    <ul id="topDoctorsList" class="space-y-3 text-gray-300"></ul>
                </div>
            </div>

            <div class="bg-gray-900 border border-gray-800 rounded-2xl shadow-lg overflow-hidden">
                <header class="px-6 py-4 border-b border-gray-800 bg-gray-850 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <i class="fas fa-exclamation-triangle text-purple-400 text-xl"></i>
                        <h2 class="text-xl font-semibold text-white">Expiring Insurance</h2>
                    </div>
                    <span id="expiringSoonCount" class="px-4 py-1 rounded-full bg-purple-600/30 text-purple-300 font-semibold">0</span>
                </header>
                <div class="p-6 max-h-96 overflow-y-auto custom-scrollbar">
                    <table class="w-full text-left text-gray-300 text-sm">
                        <thead class="border-b border-gray-700 text-gray-400">
                            <tr>
                                <th class="pb-2 font-medium">Patient</th>
                                <th class="pb-2 font-medium">Provider</th>
                                <th class="pb-2 font-medium">Policy</th>
                                <th class="pb-2 font-medium">End Date</th>
                            </tr>
                        </thead>
                        <tbody id="expiringInsuranceTable"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- FINAL CHARTS -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="bg-gray-900 border border-gray-800 rounded-2xl shadow-lg overflow-hidden">
                <header class="px-6 py-4 border-b border-gray-800 bg-gray-850 flex items-center gap-3">
                    <i class="fas fa-star text-purple-400 text-xl"></i>
                    <h2 class="text-xl font-semibold text-white">Doctor Feedback Ratings</h2>
                </header>
                <div class="p-6">
                    <canvas id="feedbackChart" class="max-h-80"></canvas>
                </div>
            </div>

            <div class="bg-gray-900 border border-gray-800 rounded-2xl shadow-lg overflow-hidden">
                <header class="px-6 py-4 border-b border-gray-800 bg-gray-850 flex items-center gap-3">
                    <i class="fas fa-hospital text-purple-400 text-xl"></i>
                    <h2 class="text-xl font-semibold text-white">Ward Utilization</h2>
                </header>
                <div class="p-6">
                    <canvas id="wardChart" class="max-h-80"></canvas>
                </div>
            </div>
        </section>

    </div>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 8px; }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #6b21a8;
        border-radius: 10px;
    }

    .bgColorOverRide{
        background-color:#000000;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/Analytics/analytics.js"></script>
    <script>
        Chart.defaults.color = '#9ca3af';
        Chart.defaults.borderColor = 'rgba(156, 163, 175, 0.1)';
    </script>
}