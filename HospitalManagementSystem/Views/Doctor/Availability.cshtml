@{
    ViewData["Title"] = "Doctor Availability";
}

<div class="min-h-screen bg-gray-900 text-gray-200 transition-all duration-300" id="mainContent">
    <!-- Page Title -->
    <div class="px-6 py-8 lg:ml-64">
        <h2 class="text-4xl font-extrabold text-center text-purple-500 mb-10 drop-shadow-lg">
            Doctor Availability Schedule
        </h2>

        <!-- Doctor Selection -->
        <div class="mb-10 max-w-lg mx-auto">
            <label for="doctorSelect" class="block text-sm font-semibold text-gray-400 mb-3">
                Select Doctor:
            </label>
            <select id="doctorSelect"
                    class="w-full px-5 py-3 bg-gray-900 text-gray-100 border border-gray-700 rounded-2xl shadow-inner focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition duration-300 ease-in-out hover:bg-gray-800">
                <option>Select a doctor</option>
                <!-- Add more options dynamically -->
            </select>
        </div>

        <!-- Availability Table -->
        <div id="availabilityContainer" class="hidden">
            <h4 class="text-2xl font-semibold text-purple-400 mb-6 text-center drop-shadow-md">
                Weekly Schedule
            </h4>
            <div class="overflow-x-auto rounded-2xl shadow-xl border border-gray-700">
                <table class="min-w-full table-auto border-collapse">
                    <thead class="bg-gray-800">
                        <tr>
                            <th class="px-4 py-3 border border-gray-700 text-center font-semibold text-purple-300 sticky top-0 bg-gray-800 z-20 shadow-md">
                                Day
                            </th>
                            @for (int hour = 0; hour < 24; hour++)
                            {
                                <th class="px-4 py-3 border border-gray-700 text-center font-medium text-purple-200 sticky top-0 bg-gray-800 z-10 shadow-sm">
                                    @hour:00
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody id="availabilityTableBody" class="divide-y divide-gray-700 bg-gray-900">
                        <!-- Example Row -->
                        <tr class="hover:bg-gray-800 transition-colors duration-200">
                            <td class="px-4 py-2 text-center text-purple-300 font-medium border border-gray-700">
                                Monday
                            </td>
                            @for (int hour = 0; hour < 24; hour++)
                            {
                                <td class="px-4 py-2 text-center text-gray-300 border border-gray-700 hover:bg-purple-700 hover:text-white transition-colors duration-200 cursor-pointer">
                                    <!-- Availability status -->
                                </td>
                            }
                        </tr>
                        <!-- More rows dynamically -->
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/Doctor/availability.js"></script>

    <script>
        // Example: dynamically adjust main content padding based on sidebar state
        function adjustContentMargin(isSidebarOpen) {
            const content = document.getElementById('mainContent');
            if (isSidebarOpen) {
                content.classList.add('lg:ml-64');
            } else {
                content.classList.remove('lg:ml-64');
            }
        }

        // Hook this function to your sidebar toggle event
        // Example: adjustContentMargin(true/false)
    </script>
}
