@{
    ViewData["Title"] = "Doctor Management";
}

<div class="min-h-screen bg-gray-900 p-6">
    <div class="max-w-7xl mx-auto">
        <div class="bg-gray-800 rounded-2xl shadow-2xl border border-gray-700 overflow-hidden">
            <!-- Header -->
            <div class="bg-gray-800 border-b border-gray-700 px-6 py-4">
                <div class="flex items-center justify-between">
                    <h4 class="text-2xl font-bold text-purple-400 flex items-center gap-2">
                        <i class="fas fa-user-md"></i>
                        Doctors Management
                    </h4>
                    <button class="bg-gradient-to-r from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 text-white font-semibold px-4 py-2 rounded-lg shadow-lg transition-all flex items-center gap-2"
                            id="btnAddDoctor">
                        <i class="fas fa-plus-circle"></i>
                        Add Doctor
                    </button>
                </div>
            </div>

            <!-- Message Container -->
            <div id="messageContainer" class="px-6 pt-4"></div>

            <!-- Grid Body -->
            <div class="p-6">
                <div id="doctorGrid" class="ag-theme-alpine-dark" style="height: 600px; width: 100%;"></div>
            </div>
        </div>
    </div>
</div>

<!-- Add Doctor Modal -->
<div class="fixed inset-0 bg-black/60 flex items-center justify-center p-4 z-50 hidden"
     id="addDoctorModal"
     tabindex="-1">
    <div class="bg-gray-800 rounded-2xl shadow-2xl border border-gray-700 w-full max-w-4xl transform transition-all max-h-[90vh] overflow-y-auto">
        <!-- Modal Header -->
        <div class="bg-purple-600 px-6 py-4 flex items-center justify-between rounded-t-2xl sticky top-0 z-10">
            <h5 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fas fa-user-plus"></i>
                Add Doctor
            </h5>
            <button type="button"
                    class="text-white hover:text-gray-200 text-2xl transition-colors"
                    onclick="document.getElementById('addDoctorModal').classList.add('hidden')">
                &times;
            </button>
        </div>

        <!-- Modal Body -->
        <div class="p-6">
            <!-- Error Container -->
            <div id="doctorFormErrors" class="bg-red-600/20 border border-red-500 text-red-300 p-3 rounded-lg mb-4 hidden"></div>

            <form id="addDoctorForm" class="space-y-4">
                <input type="hidden" id="DoctorCode" name="DoctorCode" value="DOC001" />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- First Name -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">
                            <i class="fas fa-user text-purple-400 mr-2"></i>First Name
                        </label>
                        <input type="text" name="FirstName"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                               placeholder="Enter first name" required>
                    </div>

                    <!-- Last Name -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">
                            <i class="fas fa-user text-purple-400 mr-2"></i>Last Name
                        </label>
                        <input type="text" name="LastName"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                               placeholder="Enter last name" required>
                    </div>

                    <!-- Gender -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">
                            <i class="fas fa-venus-mars text-purple-400 mr-2"></i>Gender
                        </label>
                        <select name="Gender"
                                class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                                required>
                            <option value="">Select Gender</option>
                            <option>Male</option>
                            <option>Female</option>
                            <option>Other</option>
                        </select>
                    </div>

                    <!-- Date of Birth -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">
                            <i class="fas fa-birthday-cake text-purple-400 mr-2"></i>Date of Birth
                        </label>
                        <input type="date" name="DateOfBirth"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                               required>
                    </div>

                    <!-- Email -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">
                            <i class="fas fa-envelope text-purple-400 mr-2"></i>Email
                        </label>
                        <input type="email" name="Email"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                               placeholder="doctor@hospital.com">
                    </div>

                    <!-- Phone Number -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">
                            <i class="fas fa-phone text-purple-400 mr-2"></i>Phone Number
                        </label>
                        <input type="text" name="PhoneNumber"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                               placeholder="+1 234 567 8900">
                    </div>

                    <!-- Password -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">
                            <i class="fas fa-lock text-purple-400 mr-2"></i>Password
                        </label>
                        <input type="password" name="PasswordHash"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                               placeholder="Enter password">
                    </div>

                    <!-- Specialization -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">
                            <i class="fas fa-stethoscope text-purple-400 mr-2"></i>Specialization
                        </label>
                        <input type="text" name="Specialization"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                               placeholder="e.g., Cardiology">
                    </div>

                    <!-- Qualification -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">
                            <i class="fas fa-graduation-cap text-purple-400 mr-2"></i>Qualification
                        </label>
                        <input type="text" name="Qualification"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                               placeholder="e.g., MBBS, MD">
                    </div>

                    <!-- Experience Years -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">
                            <i class="fas fa-briefcase text-purple-400 mr-2"></i>Experience (Years)
                        </label>
                        <input type="number" name="ExperienceYears"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                               placeholder="0">
                    </div>

                    <!-- Address -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">
                            <i class="fas fa-map-marker-alt text-purple-400 mr-2"></i>Address
                        </label>
                        <input type="text" name="Address"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                               placeholder="Street address">
                    </div>

                    <!-- City -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">
                            <i class="fas fa-city text-purple-400 mr-2"></i>City
                        </label>
                        <input type="text" name="City"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                               placeholder="City name">
                    </div>

                    <!-- State -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">
                            <i class="fas fa-flag text-purple-400 mr-2"></i>State
                        </label>
                        <input type="text" name="State"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                               placeholder="State name">
                    </div>

                    <!-- Zip Code -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">
                            <i class="fas fa-mail-bulk text-purple-400 mr-2"></i>Zip Code
                        </label>
                        <input type="text" name="ZipCode"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                               placeholder="12345">
                    </div>

                    <!-- Slot -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">
                            <i class="fas fa-clock text-purple-400 mr-2"></i>Slot
                        </label>
                        <select name="SlotId" id="SlotId"
                                class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                                required>
                            <option value="">Select Slot</option>
                        </select>
                    </div>

                    <!-- Department -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">
                            <i class="fas fa-building text-purple-400 mr-2"></i>Department
                        </label>
                        <select name="DepartmentId" id="DepartmentId"
                                class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                                required>
                            <option value="">Select Department</option>
                        </select>
                    </div>
                </div>
            </form>
        </div>

        <!-- Modal Footer -->
        <div class="bg-gray-800 border-t border-gray-700 px-6 py-4 flex items-center justify-end gap-3 rounded-b-2xl sticky bottom-0">
            <button type="button"
                    class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-gray-300 font-semibold rounded-lg transition-colors"
                    onclick="document.getElementById('addDoctorModal').classList.add('hidden')">
                Cancel
            </button>
            <button type="button"
                    id="saveDoctorBtn"
                    class="px-4 py-2 bg-gradient-to-r from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 text-white font-semibold rounded-lg shadow-lg transition-all">
                Save Doctor
            </button>
        </div>
    </div>
</div>

<!-- Edit Doctor Modal -->
<div class="fixed inset-0 bg-black/60 flex items-center justify-center p-4 z-50 hidden"
     id="editDoctorModal"
     tabindex="-1">
    <div class="bg-gray-800 rounded-2xl shadow-2xl border border-gray-700 w-full max-w-4xl transform transition-all max-h-[90vh] overflow-y-auto">
        <!-- Modal Header -->
        <div class="bg-purple-600 px-6 py-4 flex items-center justify-between rounded-t-2xl sticky top-0 z-10">
            <h5 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fas fa-user-edit"></i>
                Edit Doctor
            </h5>
            <button type="button"
                    class="text-white hover:text-gray-200 text-2xl transition-colors"
                    onclick="document.getElementById('editDoctorModal').classList.add('hidden')">
                &times;
            </button>
        </div>

        <!-- Modal Body -->
        <div class="p-6">
            <!-- Error Container -->
            <div id="editDoctorErrors" class="bg-red-600/20 border border-red-500 text-red-300 p-3 rounded-lg mb-4 hidden"></div>

            <form id="editDoctorForm" class="space-y-4">
                <input type="hidden" id="editDoctorId">
                <input type="hidden" id="editFullName" class="form-control">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- First Name -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">First Name</label>
                        <input type="text" id="editFirstName"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all">
                    </div>

                    <!-- Last Name -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">Last Name</label>
                        <input type="text" id="editLastName"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all">
                    </div>

                    <!-- Gender -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">Gender</label>
                        <select id="editGender"
                                class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all">
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <!-- Email -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">Email</label>
                        <input type="email" id="editEmail"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all">
                    </div>

                    <!-- Phone Number -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">Phone Number</label>
                        <input type="text" id="editPhoneNumber"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all">
                    </div>

                    <!-- Specialization -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">Specialization</label>
                        <input type="text" id="editSpecialization"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all">
                    </div>

                    <!-- Qualification -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">Qualification</label>
                        <input type="text" id="editQualification"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all">
                    </div>

                    <!-- Experience Years -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">Experience (Years)</label>
                        <input type="number" id="editExperienceYears"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all">
                    </div>

                    <!-- City -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">City</label>
                        <input type="text" id="editCity"
                               class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all">
                    </div>

                    <!-- Slot -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">Slot</label>
                        <select id="editSlotId"
                                class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all">
                            <option value="">Select Slot</option>
                        </select>
                    </div>

                    <!-- Department -->
                    <div>
                        <label class="block text-gray-300 font-semibold mb-2">Department</label>
                        <select id="editDepartmentId"
                                class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all">
                            <option value="">Select Department</option>
                        </select>
                    </div>
                </div>
            </form>
        </div>

        <!-- Modal Footer -->
        <div class="bg-gray-800 border-t border-gray-700 px-6 py-4 flex items-center justify-end gap-3 rounded-b-2xl sticky bottom-0">
            <button type="button"
                    class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-gray-300 font-semibold rounded-lg transition-colors"
                    onclick="document.getElementById('editDoctorModal').classList.add('hidden')">
                Cancel
            </button>
            <button type="button"
                    id="editDoctorBtn"
                    class="px-4 py-2 bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 text-white font-semibold rounded-lg shadow-lg transition-all">
                Save Changes
            </button>
        </div>
    </div>
</div>

@section Styles {
    <!-- AG Grid CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@31.0.1/styles/ag-grid.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@31.0.1/styles/ag-theme-alpine.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* AG Grid Dark Theme Customization */
        .ag-theme-alpine-dark {
            --ag-background-color: #1f2937;
            --ag-header-background-color: #374151;
            --ag-odd-row-background-color: #1f2937;
            --ag-row-hover-color: #374151;
            --ag-foreground-color: #e5e7eb;
            --ag-border-color: #4b5563;
            --ag-header-foreground-color: #a78bfa;
        }

            .ag-theme-alpine-dark ::-webkit-scrollbar {
                width: 8px;
                height: 8px;
            }

            .ag-theme-alpine-dark ::-webkit-scrollbar-track {
                background: #1f2937;
            }

            .ag-theme-alpine-dark ::-webkit-scrollbar-thumb {
                background: #6b7280;
                border-radius: 4px;
            }

                .ag-theme-alpine-dark ::-webkit-scrollbar-thumb:hover {
                    background: #9333ea;
                }
    </style>
}

@section Scripts {
    <!-- AG Grid JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/ag-grid-community@31.0.1/dist/ag-grid-community.min.js"></script>

    <script>
        // Modal helper functions
        window.showModal = function(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
        };

        window.hideModal = function(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        };

        // Add Doctor button click
        document.getElementById('btnAddDoctor').addEventListener('click', function() {
            showModal('addDoctorModal');
        });

        // Close modals on escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                hideModal('addDoctorModal');
                hideModal('editDoctorModal');
            }
        });

        // Close modals on backdrop click
        document.getElementById('addDoctorModal').addEventListener('click', function(e) {
            if (e.target === this) {
                hideModal('addDoctorModal');
            }
        });

        document.getElementById('editDoctorModal').addEventListener('click', function(e) {
            if (e.target === this) {
                hideModal('editDoctorModal');
            }
        });
    </script>

    <script src="~/js/Doctor/doctor.js"></script>
}