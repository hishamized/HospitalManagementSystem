@{
    ViewData["Title"] = "ViewManageVisits";
}

<div class="mx-64 mt-6 space-y-4">

    <!-- Page Header -->
    <h4 class="text-xl font-semibold text-purple-400">Patient Visits</h4>

    <!-- Patient Visits AG Grid -->
    <div id="patientVisitsGrid"
         class="ag-theme-alpine-dark min-h-[400px] w-full rounded-lg"
         style="height: 500px;">
    </div>

    <!-- No Records Message -->
    <p id="noRecordsMessage" class="mt-2 hidden font-semibold text-red-400">
        No visit records found.
    </p>
</div>


<!-- ========================= -->
<!-- Bills Modal (Tailwind)   -->
<!-- ========================= -->
<div id="billsModal"
     x-data="{ open: false }"
     x-show="open"
     class="fixed inset-0 z-40 flex items-center justify-center bg-black/60"
     x-transition.opacity
     style="display:none;">

    <div class="relative w-[85%] rounded-xl bg-gray-900 p-6 text-gray-200 shadow-xl">

        <!-- Header -->
        <h3 class="text-lg font-semibold text-purple-300">Patient Bills</h3>

        <button id="closeBillsModal"
                class="absolute right-4 top-3 text-red-400 hover:text-red-500">
            <i class="fa-solid fa-xmark text-2xl"></i>
        </button>

        <!-- Bills Grid -->
        <div id="patientBillsGrid"
             class="ag-theme-alpine-dark mt-4 w-full rounded-lg"
             style="height: 400px;">
        </div>

    </div>
</div>


<!-- ============================== -->
<!-- Payment Modal (Tailwind/Alpine) -->
<!-- ============================== -->
<div id="paymentModal"
     x-data="{ open: false }"
     x-show="open"
     class="fixed inset-0 z-50 flex items-center justify-center bg-black/60"
     x-transition.opacity
     style="display:none;">

    <div class="relative w-[500px] rounded-xl bg-gray-900 p-6 text-gray-200 shadow-2xl">

        <!-- Header -->
        <div class="mb-4 border-b border-gray-700 pb-3">
            <h3 class="text-xl font-semibold text-purple-300">
                Complete Your Payment
            </h3>

            <button id="closePaymentModal"
                    class="absolute right-4 top-4 text-red-400 hover:text-red-500">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <!-- Bill Summary -->
        <div class="mb-4 space-y-2 rounded-lg bg-gray-800 p-4">
            <div class="flex justify-between text-gray-400">
                <span>Bill ID:</span>
                <span id="paymentBillId" class="font-semibold text-gray-200">-</span>
            </div>
            <div class="flex justify-between text-gray-400">
                <span>Visit ID:</span>
                <span id="paymentVisitId" class="font-semibold text-gray-200">-</span>
            </div>
            <div class="flex justify-between text-lg">
                <span class="font-semibold text-purple-300">Amount to Pay:</span>
                <span id="paymentAmount" class="font-bold text-green-400">₹0.00</span>
            </div>
        </div>

        <!-- Payment Form -->
        <form id="paymentForm" class="space-y-4">
            @Html.AntiForgeryToken();
            <input type="hidden" id="PaymentFormVisitId" name="VisitId" value="" />

            <!-- Payment Method -->
            <div>
                <label class="mb-2 block font-medium text-gray-300">
                    Select Payment Method *
                </label>

                <div class="grid grid-cols-2 gap-3">

                    <label class="flex cursor-pointer items-center gap-2 rounded-lg bg-gray-800 p-3 hover:bg-gray-700">
                        <input type="radio" name="paymentMethod" value="credit_card" required>
                        <span>💳 Credit Card</span>
                    </label>

                    <label class="flex cursor-pointer items-center gap-2 rounded-lg bg-gray-800 p-3 hover:bg-gray-700">
                        <input type="radio" name="paymentMethod" value="debit_card">
                        <span>💳 Debit Card</span>
                    </label>

                    <label class="flex cursor-pointer items-center gap-2 rounded-lg bg-gray-800 p-3 hover:bg-gray-700">
                        <input type="radio" name="paymentMethod" value="upi">
                        <span>📱 UPI</span>
                    </label>

                    <label class="flex cursor-pointer items-center gap-2 rounded-lg bg-gray-800 p-3 hover:bg-gray-700">
                        <input type="radio" name="paymentMethod" value="net_banking">
                        <span>🏦 Net Banking</span>
                    </label>

                </div>
            </div>

            <!-- Card Details -->
            <div id="cardDetailsSection"
                 class="hidden space-y-3 rounded-lg border border-gray-700 p-4">

                <div>
                    <label class="mb-1 block font-medium">Card Number *</label>
                    <input id="cardNumber"
                           maxlength="19"
                           class="w-full rounded-lg border border-gray-700 bg-gray-800 p-2" />
                </div>

                <div class="flex gap-4">
                    <div class="flex-1">
                        <label class="mb-1 block font-medium">Expiry (MM/YY) *</label>
                        <input id="cardExpiry"
                               maxlength="5"
                               class="w-full rounded-lg border border-gray-700 bg-gray-800 p-2" />
                    </div>

                    <div class="flex-1">
                        <label class="mb-1 block font-medium">CVV *</label>
                        <input id="cardCvv"
                               maxlength="4"
                               class="w-full rounded-lg border border-gray-700 bg-gray-800 p-2" />
                    </div>
                </div>
            </div>

            <!-- UPI -->
            <div id="upiDetailsSection"
                 class="hidden rounded-lg border border-gray-700 p-4">
                <label class="mb-1 block font-medium">UPI ID *</label>
                <input id="upiId"
                       class="w-full rounded-lg border border-gray-700 bg-gray-800 p-2" />
            </div>

            <!-- Net Banking -->
            <div id="netBankingDetailsSection"
                 class="hidden rounded-lg border border-gray-700 p-4">
                <label class="mb-1 block font-medium">Select Bank *</label>
                <select id="bankName"
                        class="w-full rounded-lg border border-gray-700 bg-gray-800 p-2">
                    <option value="">-- Select Bank --</option>
                    <option value="sbi">State Bank of India</option>
                    <option value="hdfc">HDFC Bank</option>
                    <option value="icici">ICICI Bank</option>
                    <option value="axis">Axis Bank</option>
                    <option value="kotak">Kotak Mahindra Bank</option>
                    <option value="pnb">Punjab National Bank</option>
                </select>
            </div>

            <!-- Pay Btn -->
            <button id="submitPayment"
                    type="submit"
                    class="w-full rounded-lg bg-purple-600 py-3 font-semibold text-white hover:bg-purple-700">
                Pay Now
            </button>
        </form>

        <p class="mt-3 text-center text-xs text-gray-500">
            🔒 Your payment information is secure and encrypted
        </p>

    </div>
</div>


<!-- Payment Success Modal -->
<div id="paymentSuccessModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60">
    <div class="relative w-[90%] max-w-md rounded-xl bg-green-600 p-6 text-white shadow-2xl">
        <div class="mb-4 flex items-center justify-between">
            <h5 class="text-lg font-semibold">Payment Successful</h5>
            <button id="closePaymentSuccess"
                    onclick="wrapModal('paymentSuccessModal')"
                    class="text-2xl transition-colors hover:text-gray-200">
                &times;
            </button>
        </div>
        <div class="text-center">
            <i class="fa-solid fa-circle-check text-6xl"></i>
            <p class="mt-3 text-lg">The payment has been processed successfully.</p>
        </div>
        <div class="mt-6 flex justify-center">
            <button id="okPaymentSuccess"
                    onclick="wrapModal('paymentSuccessModal')"
                    class="rounded-lg bg-white px-6 py-2 font-semibold text-green-600 transition-colors hover:bg-gray-100">
                OK
            </button>
        </div>
    </div>
</div>

<!-- Discharge Summary Modal -->
<div id="dischargeSummaryModal"
     class="fixed inset-0 z-50 hidden items-center justify-center overflow-y-auto bg-black/60">
    <div class="relative w-[95%] max-w-4xl rounded-xl bg-gray-900 p-6 text-gray-200 shadow-2xl">
        <div class="mb-4 flex items-center justify-between border-b border-gray-700 pb-3">
            <h5 class="text-lg font-semibold text-purple-300">Discharge Summary</h5>
            <button id="closeDischargeSummary"
                    onclick="wrapModal('dischargeSummaryModal')"
                    class="text-2xl text-red-400 transition-colors hover:text-red-500">
                &times;
            </button>
        </div>
        <div id="dischargeSummaryContent" class="max-h-[70vh] overflow-y-auto">
            <div class="text-center text-gray-400">Loading summary...</div>
        </div>
        <div class="mt-6 flex justify-end gap-3">
            <button id="downloadPdfBtn"
                    class="flex items-center gap-2 rounded-lg bg-green-600 px-4 py-2 text-white transition-colors hover:bg-green-700">
                <i class="fa-solid fa-file-pdf"></i> Download as PDF
            </button>
            <button id="closeDischargeFooter"
                    onclick="wrapModal('dischargeSummaryModal')"
                    class="rounded-lg bg-gray-600 px-4 py-2 text-white transition-colors hover:bg-gray-700">
                Close
            </button>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/PatientPortal/ViewManageVisits.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
}
