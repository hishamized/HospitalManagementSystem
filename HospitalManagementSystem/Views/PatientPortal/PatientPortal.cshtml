@{
    ViewData["Title"] = "Patient Portal";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="card-title text-center mb-4">Patient Portal</h2>
                    <p class="text-muted text-center mb-4">Search for your patient record</p>

                    <form id="patientSearchForm" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="identifier" class="form-label">
                                Enter your Patient Code, Email or Phone Number
                            </label>
                            <input type="text"
                                   class="form-control"
                                   id="identifier"
                                   name="identifier"
                                   placeholder="e.g., P12345 or email@example.com"
                                   required />
                            <div class="form-text">
                                Enter any of: Patient Code, Email Address, or Contact Number
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-search me-2"></i>Search
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-3">
                <small class="text-muted">
                    <i class="bi bi-shield-lock me-1"></i>Your information is secure and confidential
                </small>
            </div>
        </div>
    </div>
</div>

<!-- 🔹 Hidden Patient Info Modal -->
<div class="modal fade" id="patientModal" tabindex="-1" aria-labelledby="patientModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title" id="patientModalLabel">Patient Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="patientModalBody">
                <!-- Patient details will be inserted here dynamically -->
            </div>
            <div class="modal-footer" id="patientModalFooter">
                <!-- Button will appear dynamically -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/PatientPortal/PatientPortal.js"></script>
}
