@{
    ViewData["Title"] = "Departments";
}

<div class="min-h-screen bg-gray-900 p-6">
    <div class="max-w-7xl mx-auto">
        <div class="bg-gray-800 rounded-2xl shadow-2xl border border-gray-700 overflow-hidden">
            <!-- Header -->
            <div class="bg-gray-800 border-b border-gray-700 px-6 py-4">
                <div class="flex items-center justify-between">
                    <h4 class="text-2xl font-bold text-purple-400 flex items-center gap-2">
                        <i class="fas fa-building"></i>
                        Department Management
                    </h4>
                    <button class="bg-gradient-to-r from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 text-white font-semibold px-4 py-2 rounded-lg shadow-lg transition-all flex items-center gap-2"
                            id="btnAddDepartment">
                        <i class="fas fa-plus-circle"></i>
                        Add Department
                    </button>
                </div>
            </div>

            <!-- Grid Body -->
            <div class="p-6">
                <div id="departmentsGrid" class="ag-theme-alpine-dark" style="height: 600px; width: 100%;"></div>
            </div>
        </div>
    </div>
</div>

<!-- Add Department Modal -->
<div class="fixed inset-0 bg-black/60 flex items-center justify-center p-4 z-50 hidden"
     id="addDepartmentModal"
     tabindex="-1">
    <div class="bg-gray-800 rounded-2xl shadow-2xl border border-gray-700 w-full max-w-md transform transition-all">
        <!-- Modal Header -->
        <div class="bg-purple-600 px-6 py-4 flex items-center justify-between rounded-t-2xl">
            <h5 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fas fa-plus-circle"></i>
                Add Department
            </h5>
            <button type="button"
                    class="text-white hover:text-gray-200 text-2xl transition-colors"
                    onclick="document.getElementById('addDepartmentModal').classList.add('hidden')">
                &times;
            </button>
        </div>

        <!-- Modal Body -->
        <div class="p-6">
            <form id="addDepartmentForm" class="space-y-4">
                <div>
                    <label for="departmentName" class="block text-gray-300 font-semibold mb-2">
                        <i class="fas fa-tag text-purple-400 mr-2"></i>Department Name
                    </label>
                    <input type="text"
                           class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                           id="departmentName"
                           name="Name"
                           placeholder="Enter department name"
                           required>
                    <div class="text-red-400 text-sm mt-1 hidden" id="nameError"></div>
                </div>

                <div>
                    <label for="departmentDescription" class="block text-gray-300 font-semibold mb-2">
                        <i class="fas fa-align-left text-purple-400 mr-2"></i>Description
                    </label>
                    <textarea class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all resize-none"
                              id="departmentDescription"
                              name="Description"
                              placeholder="Enter description (optional)"
                              rows="4"></textarea>
                    <div class="text-red-400 text-sm mt-1 hidden" id="descriptionError"></div>
                </div>

                <div class="text-red-400 text-sm hidden" id="formError"></div>

                <div class="flex items-center justify-end gap-3 pt-4">
                    <button type="button"
                            class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-gray-300 font-semibold rounded-lg transition-colors"
                            onclick="document.getElementById('addDepartmentModal').classList.add('hidden')">
                        Cancel
                    </button>
                    <button type="submit"
                            class="px-4 py-2 bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 text-white font-semibold rounded-lg shadow-lg transition-all">
                        Save Department
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Department Modal -->
<div class="fixed inset-0 bg-black/60 flex items-center justify-center p-4 z-50 hidden"
     id="editDepartmentModal"
     tabindex="-1">
    <div class="bg-gray-800 rounded-2xl shadow-2xl border border-gray-700 w-full max-w-md transform transition-all">
        <!-- Modal Header -->
        <div class="bg-purple-600 px-6 py-4 flex items-center justify-between rounded-t-2xl">
            <h5 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fas fa-edit"></i>
                Edit Department
            </h5>
            <button type="button"
                    class="text-white hover:text-gray-200 text-2xl transition-colors"
                    onclick="document.getElementById('editDepartmentModal').classList.add('hidden')">
                &times;
            </button>
        </div>

        <!-- Modal Body -->
        <div class="p-6">
            <form id="editDepartmentForm" class="space-y-4">
                <input type="hidden" id="editDepartmentId" />

                <div>
                    <label for="editDepartmentName" class="block text-gray-300 font-semibold mb-2">
                        <i class="fas fa-tag text-purple-400 mr-2"></i>Department Name
                    </label>
                    <input type="text"
                           class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                           id="editDepartmentName"
                           placeholder="Enter department name"
                           required>
                    <div class="text-red-400 text-sm mt-1 hidden" id="editNameError"></div>
                </div>

                <div>
                    <label for="editDepartmentDescription" class="block text-gray-300 font-semibold mb-2">
                        <i class="fas fa-align-left text-purple-400 mr-2"></i>Description
                    </label>
                    <textarea class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all resize-none"
                              id="editDepartmentDescription"
                              placeholder="Enter description (optional)"
                              rows="4"></textarea>
                    <div class="text-red-400 text-sm mt-1 hidden" id="editDescriptionError"></div>
                </div>

                <div class="text-red-400 text-sm hidden" id="editFormError"></div>

                <div class="flex items-center justify-end gap-3 pt-4">
                    <button type="button"
                            class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-gray-300 font-semibold rounded-lg transition-colors"
                            onclick="document.getElementById('editDepartmentModal').classList.add('hidden')">
                        Cancel
                    </button>
                    <button type="submit"
                            class="px-4 py-2 bg-gradient-to-r from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 text-white font-semibold rounded-lg shadow-lg transition-all">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <!-- AG Grid CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@31.0.1/styles/ag-grid.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@31.0.1/styles/ag-theme-alpine.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* AG Grid Dark Theme Customization */
        .ag-theme-alpine-dark {
            --ag-background-color: #1f2937;
            --ag-header-background-color: #374151;
            --ag-odd-row-background-color: #1f2937;
            --ag-row-hover-color: #374151;
            --ag-foreground-color: #e5e7eb;
            --ag-border-color: #4b5563;
            --ag-header-foreground-color: #a78bfa;
        }

            /* Custom scrollbar for dark theme */
            .ag-theme-alpine-dark ::-webkit-scrollbar {
                width: 8px;
                height: 8px;
            }

            .ag-theme-alpine-dark ::-webkit-scrollbar-track {
                background: #1f2937;
            }

            .ag-theme-alpine-dark ::-webkit-scrollbar-thumb {
                background: #6b7280;
                border-radius: 4px;
            }

                .ag-theme-alpine-dark ::-webkit-scrollbar-thumb:hover {
                    background: #9333ea;
                }
    </style>
}

@section Scripts {
    <!-- AG Grid JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/ag-grid-community@31.0.1/dist/ag-grid-community.min.js"></script>

    <script>
        // Modal helper functions
        window.showModal = function(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
        };

        window.hideModal = function(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        };

        // Add Department button click
        document.getElementById('btnAddDepartment').addEventListener('click', function() {
            showModal('addDepartmentModal');
        });

        // Close modals on escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                hideModal('addDepartmentModal');
                hideModal('editDepartmentModal');
            }
        });

        // Close modals on backdrop click
        document.getElementById('addDepartmentModal').addEventListener('click', function(e) {
            if (e.target === this) {
                hideModal('addDepartmentModal');
            }
        });

        document.getElementById('editDepartmentModal').addEventListener('click', function(e) {
            if (e.target === this) {
                hideModal('editDepartmentModal');
            }
        });
    </script>

    <script src="~/js/Department/department.js"></script>
}