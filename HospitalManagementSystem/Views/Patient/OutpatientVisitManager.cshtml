@model HMS.Application.DTO.Patient.OutPatientDetailsDto
@{
    ViewData["Title"] = "Outpatient Visit Manager";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-3">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="mb-0 text-primary fw-bold">Outpatient Visit Summary</h4>
                        <a href="javascript:window.close()" class="btn btn-sm btn-outline-secondary">Close</a>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label text-muted">Patient Code</label>
                            <div class="fw-semibold">@Model.PatientCode</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted">Full Name</label>
                            <div class="fw-semibold">@Model.FullName</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted">Gender</label>
                            <div class="fw-semibold">@Model.Gender</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted">Date of Birth</label>
                            <div class="fw-semibold">@Model.DateOfBirth.ToString("dd-MMM-yyyy")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted">Contact Number</label>
                            <div class="fw-semibold">@Model.ContactNumber</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted">Email</label>
                            <div class="fw-semibold">@Model.Email</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted">City</label>
                            <div class="fw-semibold">@Model.City</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted">State</label>
                            <div class="fw-semibold">@Model.State</div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label text-muted">Visit Date</label>
                            <div class="fw-semibold">@Model.VisitDate.ToString("dd-MMM-yyyy")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted">Doctor Name</label>
                            <div class="fw-semibold">@Model.DoctorName</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted">Treatment</label>
                            <div class="fw-semibold">@Model.TreatmentDetails</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted">Notes</label>
                            <div class="fw-semibold">@Model.Notes</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="text-primary fw-bold mb-0">Outpatient Billing Information</h5>
                        <button id="btnAddBill" class="btn btn-sm btn-primary">Add Bill</button>
                    </div>
                    <div id="outpatientBillGrid" class="ag-theme-alpine" style="height: 400px; width: 100%;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Outpatient Bill Modal -->
<div class="modal fade" id="addOutpatientBillModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Add Outpatient Bill</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addOutpatientBillForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="patientId" value="@Model.PatientId" />
                    <input type="hidden" id="visitId" value="@Model.VisitId" />
                    <input type="hidden" id="visitType" value="Outpatient" />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Bill Date</label>
                            <input type="date" class="form-control" id="billDate" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">OPD Consultation Fee</label>
                            <input type="number" class="form-control" id="opdConsultationFee" step="0.01" min="0" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Consultation Charges</label>
                            <input type="number" class="form-control" id="consultationCharges" step="0.01" min="0" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Medication Charges</label>
                            <input type="number" class="form-control" id="medicationCharges" step="0.01" min="0" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Procedure Charges</label>
                            <input type="number" class="form-control" id="procedureCharges" step="0.01" min="0" />
                        </div>

                        <div class="col-md-4 d-none">
                            <label class="form-label">Room Charges</label>
                            <input type="number" class="form-control" id="roomCharges" step="0.01" min="0" value="0" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Discount Amount</label>
                            <input type="number" class="form-control" id="discountAmount" step="0.01" min="0" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Total Amount</label>
                            <input type="number" class="form-control bg-light" id="totalAmount" readonly />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Net Amount</label>
                            <input type="number" class="form-control bg-light" id="netAmount" readonly />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Payment Mode</label>
                            <select id="paymentMode" class="form-select">
                                <option value="">Select</option>
                                <option value="Cash">Cash</option>
                                <option value="Card">Card</option>
                                <option value="UPI">UPI</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Payment Status</label>
                            <select id="paymentStatus" class="form-select">
                                <option value="Unpaid" selected>Unpaid</option>
                                <option value="Paid">Paid</option>
                            </select>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Notes</label>
                            <textarea class="form-control" id="notes" rows="2"></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" id="saveOutpatientBill">Save Bill</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editBillModal" tabindex="-1" aria-labelledby="editBillModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="editBillModalLabel">
                    <i class="bi bi-receipt-cutoff me-2"></i> Edit Bill
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="editBillForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="editBillId" name="Id" />
                    <input type="hidden" id="editPatientId" name="PatientId" />
                    <input type="hidden" id="editVisitId" name="VisitId" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Bill Date</label>
                            <input type="date" id="editBillDate" name="BillDate" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Payment Status</label>
                            <select id="editPaymentStatus" name="PaymentStatus" class="form-select" required>
                                <option value="">Select</option>
                                <option value="Pending">Pending</option>
                                <option value="Paid">Paid</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Payment Mode</label>
                            <select id="editPaymentMode" name="PaymentMode" class="form-select">
                                <option value="">Select</option>
                                <option value="Cash">Cash</option>
                                <option value="Card">Card</option>
                                <option value="UPI">UPI</option>
                                <option value="Insurance">Insurance</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Room Charges</label>
                            <input type="hidden" id="editRoomCharges" name="RoomCharges" class="form-control" step="0.01" value="0" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Procedure Charges</label>
                            <input type="number" id="editProcedureCharges" name="ProcedureCharges" class="form-control" step="0.01"  />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Medication Charges</label>
                            <input type="number" id="editMedicationCharges" name="MedicationCharges" class="form-control" step="0.01" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Consultation Charges</label>
                            <input type="hidden" id="editConsultationCharges" name="ConsultationCharges" class="form-control" step="0.01" value="0" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">OPD Consultation Fee</label>
                            <input type="number" id="editOpdConsultationFee" name="OpdConsultationFee" class="form-control" step="0.01" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Discount Amount</label>
                            <input type="number" id="editDiscountAmount" name="DiscountAmount" class="form-control" step="0.01" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Total Amount</label>
                            <input type="number" id="editTotalAmount" name="TotalAmount" class="form-control" step="0.01" readonly />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Net Amount</label>
                            <input type="number" id="editNetAmount" name="NetAmount" class="form-control" step="0.01" readonly />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Notes</label>
                            <textarea id="editNotes" name="Notes" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


<div id="outpatientContainer"
     data-patient-id="@Model.PatientId"
     data-visit-id="@Model.VisitId">
</div>
@section Scripts {
    <script src="~/js/Patient/OutpatientVisitManager.js"></script>
}


