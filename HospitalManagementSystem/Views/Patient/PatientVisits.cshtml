@{
    ViewData["Title"] = "Patient Visits";
}

<div class="z-0 min-h-screen px-6 py-4 lg:mx-64">
    <div class="mb-3 flex items-center justify-between">
        <h4 class="text-lg font-bold">Patient Visits</h4>
        <button id="btnAddVisit" class="flex items-center rounded bg-purple-700 px-4 py-2 font-semibold text-white hover:bg-purple-800">
            <i class="mdi mdi-plus mr-2"></i> Add Patient Visit
        </button>
    </div>

    <!-- AG Grid Placeholder -->
    <div id="patientVisitGrid" class="ag-theme-alpine-dark" style="height: 500px; width: 100%;"></div>
</div>


<!-- Add/Edit Visit Modal -->
<div id="visitModal" class="fixed inset-0 z-50 flex hidden items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="mx-4 w-full max-w-4xl rounded-xl border border-gray-700 bg-gray-900 text-gray-200 shadow-2xl">

        <!-- Modal Header -->
        <div class="flex items-center justify-between rounded-t-xl border-b border-gray-700 bg-gray-800 px-6 py-4">
            <h5 id="visitModalLabel" class="text-lg font-semibold text-purple-400">Add Patient Visit</h5>
            <button type="button"
                    class="text-2xl font-bold text-gray-300 hover:text-white"
                    onclick="document.getElementById('visitModal').classList.add('hidden')">
                ✕
            </button>
        </div>

        <!-- Modal Body -->
        <div class="space-y-4 px-6 py-4">

            <div id="ErrorContainer" class="hidden rounded border border-red-700 bg-red-900/40 p-3 text-red-300"></div>

            <form id="visitForm" class="grid grid-cols-1 gap-4 md:grid-cols-2">

                <!-- Patient -->
                <div>
                    <label class="mb-1 block font-semibold">Patient</label>
                    <select id="patientId" name="PatientId"
                            class="w-full rounded border border-gray-700 bg-gray-800 px-3 py-2 text-gray-200 focus:outline-none focus:ring-2 focus:ring-purple-500">
                        <option value="">Select Patient</option>
                    </select>
                </div>

                <!-- Visit Type -->
                <div>
                    <label class="mb-1 block font-semibold">Visit Type</label>
                    <select id="visitType" name="VisitType"
                            class="w-full rounded border border-gray-700 bg-gray-800 px-3 py-2 text-gray-200 focus:ring-2 focus:ring-purple-500">
                        <option value="">Select Type</option>
                        <option value="Inpatient">Inpatient</option>
                        <option value="Outpatient">Outpatient</option>
                    </select>
                </div>

                <!-- Visit Date -->
                <div>
                    <label class="mb-1 block font-semibold">Visit Date</label>
                    <input type="datetime-local" id="visitDate" name="VisitDate"
                           class="w-full rounded border border-gray-700 bg-gray-800 px-3 py-2 text-gray-200 focus:ring-2 focus:ring-purple-500" />
                </div>

                <!-- Doctor -->
                <div>
                    <input type="hidden" id="DoctorId" name="DoctorId" />
                    <input type="hidden" id="DoctorName" name="DoctorName" />

                    <label class="mb-1 block font-semibold">Doctor</label>
                    <select id="doctorNameSelect"
                            class="w-full rounded border border-gray-700 bg-gray-800 px-3 py-2 text-gray-200 focus:ring-2 focus:ring-purple-500">
                        <option value="">Select Doctor</option>
                    </select>
                </div>

                <!-- Admission Date -->
                <div class="inpatient-field">
                    <label class="mb-1 block font-semibold">Admission Date</label>
                    <input type="datetime-local" id="admissionDate" name="AdmissionDate"
                           class="w-full rounded border border-gray-700 bg-gray-800 px-3 py-2 text-gray-200 focus:ring-2 focus:ring-purple-500" />
                </div>

                <!-- Discharge Date -->
                <div class="inpatient-field">
                    <label class="mb-1 block font-semibold">Discharge Date</label>
                    <input type="datetime-local" id="dischargeDate" name="DischargeDate"
                           class="w-full rounded border border-gray-700 bg-gray-800 px-3 py-2 text-gray-200 focus:ring-2 focus:ring-purple-500" />
                </div>

                <!-- Room Number -->
                <div class="inpatient-field">
                    <label class="mb-1 block font-semibold">Room Number</label>
                    <input type="text" id="roomNumber" name="RoomNumber"
                           class="w-full rounded border border-gray-700 bg-gray-800 px-3 py-2 text-gray-200 placeholder-gray-500 focus:ring-2 focus:ring-purple-500"
                           placeholder="Optional" />
                </div>

                <!-- Treatment Details -->
                <div class="md:col-span-2">
                    <label class="mb-1 block font-semibold">Treatment Details</label>
                    <textarea id="treatmentDetails" name="TreatmentDetails" rows="2"
                              class="w-full rounded border border-gray-700 bg-gray-800 px-3 py-2 text-gray-200 placeholder-gray-500 focus:ring-2 focus:ring-purple-500"></textarea>
                </div>

                <!-- Notes -->
                <div class="md:col-span-2">
                    <label class="mb-1 block font-semibold">Additional Notes</label>
                    <textarea id="notes" name="Notes" rows="2"
                              class="w-full rounded border border-gray-700 bg-gray-800 px-3 py-2 text-gray-200 placeholder-gray-500 focus:ring-2 focus:ring-purple-500"></textarea>
                </div>

            </form>
        </div>

        <!-- Modal Footer -->
        <div class="flex justify-end gap-3 rounded-b-xl border-t border-gray-700 bg-gray-800 px-6 py-4">

            <button type="button"
                    class="rounded bg-gray-700 px-4 py-2 text-gray-200 hover:bg-gray-600"
                    onclick="document.getElementById('visitModal').classList.add('hidden')">
                Cancel
            </button>

            <button type="button" id="saveVisitBtn"
                    class="flex items-center gap-2 rounded bg-purple-600 px-4 py-2 text-white hover:bg-purple-700">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M5 13l4 4L19 7" />
                </svg>
                Save
            </button>

        </div>

    </div>
</div>



<!-- Edit Visit Modal -->
<div id="editVisitModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm">
    <div class="flex min-h-screen items-center justify-center px-4">
        <div class="mx-auto w-full max-w-4xl rounded-xl border border-gray-700 bg-gray-900 text-gray-200 shadow-2xl">

            <!-- Header -->
            <div class="flex items-center justify-between rounded-t-xl border-b border-gray-700 bg-gray-800 px-6 py-4">
                <h5 class="text-lg font-semibold text-purple-400">Edit Patient Visit</h5>
                <button type="button"
                        class="text-2xl font-bold text-gray-300 hover:text-white"
                        onclick="document.getElementById('editVisitModal').classList.add('hidden')">
                    &times;
                </button>
            </div>

            <!-- Body -->
            <div class="px-6 py-4">
                <form id="editVisitForm" class="space-y-4">

                    <div id="editVisitError" class="text-red-400"></div>

                    <input type="hidden" id="editVisitId" name="Id" />

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">

                        <div>
                            <label class="mb-1 block font-semibold">Patient</label>
                            <select id="editPatientId" name="PatientId"
                                    class="w-full rounded border border-gray-700 bg-gray-800 px-3 py-2 text-gray-200">
                            </select>
                        </div>

                        <div>
                            <label class="mb-1 block font-semibold">Visit Type</label>
                            <select id="editVisitType" name="VisitType"
                                    class="w-full rounded border border-gray-700 bg-gray-800 px-3 py-2 text-gray-200">
                                <option value="">Select Type</option>
                                <option value="Inpatient">Inpatient</option>
                                <option value="Outpatient">Outpatient</option>
                            </select>
                        </div>

                        <div>
                            <label class="mb-1 block font-semibold">Visit Date</label>
                            <input type="datetime-local" id="editVisitDate" name="VisitDate"
                                   class="w-full rounded border border-gray-700 bg-gray-800 px-3 py-2 text-gray-200" />
                        </div>

                        <div>
                            <input type="hidden" id="editDoctorId" name="DoctorId" />
                            <input type="hidden" id="editDoctorName" name="DoctorName" />

                            <label class="mb-1 block font-semibold">Doctor</label>
                            <select id="editDoctorSelect"
                                    class="w-full rounded border border-gray-700 bg-gray-800 px-3 py-2 text-gray-200">
                                <option value="">Select Doctor</option>
                            </select>
                        </div>

                        <div class="inpatient-field">
                            <label class="mb-1 block font-semibold">Admission Date</label>
                            <input type="datetime-local" id="editAdmissionDate" name="AdmissionDate"
                                   class="w-full rounded border border-gray-700 bg-gray-800 px-3 py-2 text-gray-200" />
                        </div>

                        <div class="inpatient-field">
                            <label class="mb-1 block font-semibold">Discharge Date</label>
                            <input type="datetime-local" id="editDischargeDate" name="DischargeDate"
                                   class="w-full rounded border border-gray-700 bg-gray-800 px-3 py-2 text-gray-200" />
                        </div>

                        <div class="inpatient-field">
                            <label class="mb-1 block font-semibold">Room Number</label>
                            <input type="text" id="editRoomNumber" name="RoomNumber"
                                   class="w-full rounded border border-gray-700 bg-gray-800 px-3 py-2 text-gray-200" />
                        </div>

                        <div class="md:col-span-2">
                            <label class="mb-1 block font-semibold">Treatment Details</label>
                            <textarea id="editTreatmentDetails" name="TreatmentDetails"
                                      class="w-full rounded border border-gray-700 bg-gray-800 px-3 py-2 text-gray-200"
                                      rows="2"></textarea>
                        </div>

                        <div class="md:col-span-2">
                            <label class="mb-1 block font-semibold">Notes</label>
                            <textarea id="editNotes" name="Notes"
                                      class="w-full rounded border border-gray-700 bg-gray-800 px-3 py-2 text-gray-200"
                                      rows="2"></textarea>
                        </div>

                    </div>
                </form>
            </div>

            <!-- Footer -->
            <div class="flex justify-end gap-3 rounded-b-xl border-t border-gray-700 bg-gray-800 px-6 py-4">
                <button type="button"
                        class="rounded bg-gray-700 px-4 py-2 text-gray-200 hover:bg-gray-600"
                        onclick="document.getElementById('editVisitModal').classList.add('hidden')">
                    Cancel
                </button>

                <button type="button" id="updatePatientVisitBtn"
                        class="rounded bg-purple-600 px-4 py-2 text-white hover:bg-purple-700">
                    Save Changes
                </button>
            </div>

        </div>
    </div>
</div>



<!-- ====================== -->
<!-- Edit Bill Modal -->
<!-- ====================== -->
<div id="editBillModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
    <div class="flex min-h-screen items-center justify-center px-4">
        <div class="mx-auto w-full max-w-4xl rounded-xl bg-white shadow-lg">
            <!-- Modal Header -->
            <div class="flex items-center justify-between rounded-t-xl bg-blue-600 px-6 py-4 text-white">
                <h5 class="text-lg font-semibold">Edit Bill</h5>
                <button type="button" class="text-xl font-bold text-white" onclick="document.getElementById('editBillModal').classList.add('hidden')">
                    &times;
                </button>
            </div>

            <!-- Modal Body -->
            <form id="editBillForm" class="space-y-4 px-6 py-4">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editBillId" name="Id" />
                <input type="hidden" id="editPatientId" name="PatientId" />
                <input type="hidden" id="editVisitId" name="VisitId" />

                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div>
                        <label for="editBillDate" class="mb-1 block font-semibold">Bill Date</label>
                        <input type="date" id="editBillDate" name="BillDate" class="w-full rounded border border-gray-300 px-3 py-2" required />
                    </div>

                    <div>
                        <label for="editPaymentStatus" class="mb-1 block font-semibold">Payment Status</label>
                        <select id="editPaymentStatus" name="PaymentStatus" class="w-full rounded border border-gray-300 px-3 py-2" required>
                            <option value="Paid">Paid</option>
                            <option value="Unpaid">Unpaid</option>
                            <option value="Partial">Partial</option>
                        </select>
                    </div>

                    <div>
                        <label for="editPaymentMode" class="mb-1 block font-semibold">Payment Mode</label>
                        <select id="editPaymentMode" name="PaymentMode" class="w-full rounded border border-gray-300 px-3 py-2">
                            <option value="">Select Mode</option>
                            <option value="Cash">Cash</option>
                            <option value="Card">Card</option>
                            <option value="UPI">UPI</option>
                        </select>
                    </div>

                    <div>
                        <label for="editRoomCharges" class="mb-1 block font-semibold">Room Charges</label>
                        <input type="number" step="0.01" id="editRoomCharges" name="RoomCharges" class="w-full rounded border border-gray-300 px-3 py-2" />
                    </div>

                    <div>
                        <label for="editProcedureCharges" class="mb-1 block font-semibold">Procedure Charges</label>
                        <input type="number" step="0.01" id="editProcedureCharges" name="ProcedureCharges" class="w-full rounded border border-gray-300 px-3 py-2" />
                    </div>

                    <div>
                        <label for="editMedicationCharges" class="mb-1 block font-semibold">Medication Charges</label>
                        <input type="number" step="0.01" id="editMedicationCharges" name="MedicationCharges" class="w-full rounded border border-gray-300 px-3 py-2" />
                    </div>

                    <div>
                        <label for="editConsultationCharges" class="mb-1 block font-semibold">Consultation Charges</label>
                        <input type="number" step="0.01" id="editConsultationCharges" name="ConsultationCharges" class="w-full rounded border border-gray-300 px-3 py-2" />
                    </div>

                    <div>
                        <label for="editOpdConsultationFee" class="mb-1 block font-semibold">OPD Consultation Fee</label>
                        <input type="number" step="0.01" id="editOpdConsultationFee" name="OpdConsultationFee" class="w-full rounded border border-gray-300 px-3 py-2" />
                    </div>

                    <div>
                        <label for="editDiscountAmount" class="mb-1 block font-semibold">Discount Amount</label>
                        <input type="number" step="0.01" id="editDiscountAmount" name="DiscountAmount" class="w-full rounded border border-gray-300 px-3 py-2" />
                    </div>

                    <div>
                        <label for="editTotalAmount" class="mb-1 block font-semibold">Total Amount</label>
                        <input type="number" step="0.01" id="editTotalAmount" name="TotalAmount" class="w-full rounded border border-gray-300 bg-gray-100 px-3 py-2" readonly />
                    </div>

                    <div>
                        <label for="editNetAmount" class="mb-1 block font-semibold">Net Amount</label>
                        <input type="number" step="0.01" id="editNetAmount" name="NetAmount" class="w-full rounded border border-gray-300 bg-gray-100 px-3 py-2" readonly />
                    </div>

                    <div class="md:col-span-2">
                        <label for="editNotes" class="mb-1 block font-semibold">Notes</label>
                        <textarea id="editNotes" name="Notes" rows="2" class="w-full rounded border border-gray-300 px-3 py-2"></textarea>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="mt-4 flex justify-end gap-3">
                    <button type="button" class="rounded bg-gray-200 px-4 py-2 text-gray-700 hover:bg-gray-300" onclick="document.getElementById('editBillModal').classList.add('hidden')">Cancel</button>
                    <button type="submit" class="rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>



<!-- Delete Confirmation Modal -->
<div id="deleteVisitModal" class="fixed inset-0 z-50 flex hidden items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="mx-4 w-full max-w-md rounded-xl border border-gray-700 bg-gray-900 text-gray-200 shadow-2xl">

        <!-- Modal Header -->
        <div class="flex items-center justify-between rounded-t-xl border-b border-gray-700 bg-gray-800 px-6 py-4">
            <h5 class="text-lg font-semibold text-purple-400">Confirm Delete</h5>
            <button type="button"
                    class="text-2xl font-bold text-gray-400 hover:text-white"
                    onclick="document.getElementById('deleteVisitModal').classList.add('hidden')">
                ✕
            </button>
        </div>

        <!-- Modal Body -->
        <div class="px-6 py-5 text-gray-300">
            Are you sure you want to delete this patient visit?
        </div>

        <!-- Modal Footer -->
        <div class="flex justify-end gap-3 rounded-b-xl border-t border-gray-700 bg-gray-800 px-6 py-4">
            <button type="button"
                    class="rounded bg-gray-700 px-4 py-2 text-gray-200 hover:bg-gray-600"
                    onclick="document.getElementById('deleteVisitModal').classList.add('hidden')">
                Cancel
            </button>

            <button type="button"
                    id="confirmDeleteVisitBtn"
                    class="rounded bg-purple-600 px-4 py-2 text-white hover:bg-purple-700">
                Delete
            </button>
        </div>

    </div>
</div>



@section Scripts {
    <script src="~/js/Patient/PatientVisits.js">  </script>
}
