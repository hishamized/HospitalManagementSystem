@model HMS.Application.DTO.Patient.InpatientDetailsDto;

@{
    ViewData["Title"] = "Inpatient Visit Manager";
    Layout = "_Layout";
}

<style>
    #bedGridContainer {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        gap: 10px;
    }

    .bed-box {
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        padding: 15px 10px;
        font-weight: 600;
        color: #fff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .bed-box:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

    .bg-available {
        background-color: #28a745;
    }

    .bg-occupied {
        background-color: #dc3545;
    }

    .bg-patient {
        background-color: #6f42c1;
    }

    .bg-purple {
        background-color: #6f42c1 !important;
    }

    #finalBillModal .table td,
    #finalBillModal .table th {
        padding: 0.5rem;
    }

    #finalBillModal .table-bordered {
        border: 1px solid #dee2e6;
    }

    #finalBillModal .modal-body {
        font-size: 0.95rem;
    }

    @@media print {
        .modal-footer

    {
        display: none !important;
    }

    }
</style>

<div class="mt-4 rounded-xl border border-gray-700 bg-gray-800 shadow-lg">
    <div class="p-4">

        <!-- Header -->
        <div class="mb-4 flex items-center justify-between">
            <h5 class="text-xl font-semibold text-gray-200">Patient Bills</h5>

            <div class="flex flex-wrap gap-2">

                @if (Model.IsActive == true)
                {
                    <button id="dischargeSummaryBtn"
                            data-visitid="@Model.VisitId"
                            class="flex items-center gap-1 rounded-lg bg-red-600 px-3 py-1.5 text-sm text-white hover:bg-red-700">
                        <i class="bi bi-box-arrow-right"></i> Discharge Summary
                    </button>
                }

                <button id="dischargePatientBtn"
                        data-visitid="@Model.VisitId"
                        class="flex items-center gap-1 rounded-lg bg-red-600 px-3 py-1.5 text-sm text-white hover:bg-red-700">
                    <i class="bi bi-box-arrow-right"></i> Discharge
                </button>

                <button id="GenerateFinalBillBtn"
                        data-visitid="@Model.VisitId"
                        data-patientid="@Model.PatientId"
                        class="flex items-center gap-1 rounded-lg bg-red-600 px-3 py-1.5 text-sm text-white hover:bg-red-700">
                    <i class="bi bi-receipt-cutoff"></i> Final Bill
                </button>

                <button id="btnReloadBills"
                        class="flex items-center gap-1 rounded-lg border border-purple-500 px-3 py-1.5 text-sm text-purple-400 hover:bg-purple-600 hover:text-white">
                    <i class="bi bi-arrow-clockwise"></i> Refresh
                </button>

                <button id="btnAddBill"
                        class="flex items-center gap-1 rounded-lg bg-purple-600 px-3 py-1.5 text-sm text-white hover:bg-purple-700">
                    <i class="bi bi-plus-lg"></i> Add Bill
                </button>

                <button id="btnAllotBed"
                        class="flex items-center gap-1 rounded-lg bg-purple-600 px-3 py-1.5 text-sm text-white hover:bg-purple-700">
                    <i class="bi bi-hospital"></i> Allot Bed
                </button>

                <button class="check-bed-btn flex items-center gap-1 rounded-lg bg-blue-600 px-3 py-1.5 text-sm text-white hover:bg-blue-700"
                        data-patient-id="@Model.PatientId">
                    <i class="bi bi-search"></i> Check Bed
                </button>

                <button id="removeWardBed"
                        data-has-bed="0"
                        data-patient-bed-ward-id=""
                        class="flex hidden items-center gap-1 rounded-lg bg-red-600 px-3 py-1.5 text-sm text-white hover:bg-red-700">
                    <i class="bi bi-x-circle"></i> Remove Ward/Bed
                </button>

                <button id="btnAddDoctorRound"
                        class="flex items-center gap-1 rounded-lg bg-purple-600 px-3 py-1.5 text-sm text-white hover:bg-purple-700">
                    <i class="bi bi-plus-circle"></i> Add Doctor Round
                </button>

                <button id="btnViewRoundHistory"
                        class="flex items-center gap-1 rounded-lg bg-blue-600 px-3 py-1.5 text-sm text-white hover:bg-blue-700">
                    <i class="bi bi-clock-history"></i> Round History
                </button>

            </div>
        </div>

        <!-- AG Grid -->
        <div id="billsGrid" class="ag-theme-alpine-dark" style="height: 400px; width: 100%;"></div>

    </div>
</div>


<div class="mt-6 w-full px-4">

    <!-- Header -->
    <div class="mb-4 flex items-center justify-between">
        <h4 class="text-2xl font-bold text-gray-200">Inpatient Visit Manager</h4>

        <button onclick="window.history.back();"
                class="flex items-center gap-2 rounded-lg bg-gray-700 px-4 py-2 text-gray-200 hover:bg-gray-600">
            ← Back
        </button>
    </div>

    <!-- Patient Information Card -->
    <div id="inpatient-details-section"
         class="rounded-xl border border-gray-700 bg-gray-800 p-6 text-gray-200 shadow-lg">

        <h5 class="mb-4 text-xl font-semibold">Patient Information</h5>

        <div class="mb-4 grid grid-cols-1 gap-4 md:grid-cols-3">
            <div><strong>Patient Name:</strong> @Model.FullName</div>
            <div><strong>Gender:</strong> @Model.Gender</div>
            <div><strong>Contact:</strong> @Model.ContactNumber</div>
        </div>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
            <div><strong>Visit Type:</strong> @Model.VisitType</div>
            <div><strong>Admission Date:</strong> @Model.AdmissionDate?.ToString("dd-MMM-yyyy")</div>
            <div><strong>Discharge Date:</strong> @Model.DischargeDate?.ToString("dd-MMM-yyyy")</div>
            <div><strong>Room No:</strong> @Model.RoomNumber</div>
        </div>

    </div>

    <!-- Treatment Details Card -->
    <div class="mt-6 rounded-xl border border-gray-700 bg-gray-800 p-6 text-gray-200 shadow-lg">

        <h5 class="mb-4 text-xl font-semibold">Treatment Details</h5>

        <p class="mb-4">@Model.TreatmentDetails</p>

        <h6 class="text-lg font-semibold">Notes</h6>
        <p class="text-gray-400">@Model.Notes</p>

    </div>

</div>



<!-- Add Bill Modal -->
<div id="addBillModal"
     class="fixed inset-0 z-50 flex hidden min-h-screen items-center justify-center overflow-y-auto bg-black/60 backdrop-blur-sm">

    <div class="w-full max-w-3xl rounded-xl border border-gray-700 bg-gray-800 text-gray-200 shadow-xl">

        <!-- Header -->
        <div class="flex items-center justify-between rounded-t-xl bg-purple-600 px-6 py-4 text-white">
            <h5 class="text-lg font-semibold">Add New Bill</h5>
            <button type="button"
                    class="text-xl text-white hover:text-gray-200"
                    onclick="closeModal('addBillModal')">
                ✕
            </button>
        </div>

        <!-- Body -->
        <div class="p-6">
            <form id="addBillForm">
                @Html.AntiForgeryToken()

                <!-- Hidden IDs -->
                <input type="hidden" id="PatientId" name="PatientId" value="@Model.PatientId" />
                <input type="hidden" id="VisitId" name="VisitId" value="@Model.VisitId" />
                <input type="hidden" id="VisitType" name="VisitType" value="@Model.VisitType" />

                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">

                    <div>
                        <label class="mb-1 block font-medium">Bill Date</label>
                        <input type="date"
                               id="BillDate"
                               name="BillDate"
                               required
                               class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-200
                                      focus:ring-2 focus:ring-purple-500">
                    </div>

                    <div>
                        <label class="mb-1 block font-medium">Total Amount</label>
                        <input type="number"
                               id="TotalAmount"
                               name="TotalAmount"
                               readonly
                               class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-400">
                    </div>

                    <div>
                        <label class="mb-1 block font-medium">Discount Amount</label>
                        <input type="number"
                               id="DiscountAmount"
                               name="DiscountAmount"
                               step="0.01"
                               class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-200
                                      focus:ring-2 focus:ring-purple-500">
                    </div>

                    <div>
                        <label class="mb-1 block font-medium">Net Amount</label>
                        <input type="number"
                               id="NetAmount"
                               name="NetAmount"
                               readonly
                               class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-400">
                    </div>

                    <div>
                        <label class="mb-1 block font-medium">Payment Status</label>
                        <select id="PaymentStatus"
                                name="PaymentStatus"
                                class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-200
                                       focus:ring-2 focus:ring-purple-500">
                            <option value="Unpaid">Unpaid</option>
                            <option value="Paid">Paid</option>
                            <option value="Partial">Partial</option>
                        </select>
                    </div>

                    <div>
                        <label class="mb-1 block font-medium">Payment Mode</label>
                        <select id="PaymentMode"
                                name="PaymentMode"
                                class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-200
                                       focus:ring-2 focus:ring-purple-500">
                            <option value="">-- Select --</option>
                            <option value="Cash">Cash</option>
                            <option value="Card">Card</option>
                            <option value="Insurance">Insurance</option>
                        </select>
                    </div>

                    <div>
                        <label class="mb-1 block font-medium">Room Charges</label>
                        <input type="number"
                               id="RoomCharges"
                               name="RoomCharges"
                               step="0.01"
                               class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-200
                                      focus:ring-2 focus:ring-purple-500">
                    </div>

                    <div>
                        <label class="mb-1 block font-medium">Procedure Charges</label>
                        <input type="number"
                               id="ProcedureCharges"
                               name="ProcedureCharges"
                               step="0.01"
                               class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-200
                                      focus:ring-2 focus:ring-purple-500">
                    </div>

                    <div>
                        <label class="mb-1 block font-medium">Medication Charges</label>
                        <input type="number"
                               id="MedicationCharges"
                               name="MedicationCharges"
                               step="0.01"
                               class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-200
                                      focus:ring-2 focus:ring-purple-500">
                    </div>

                    <div>
                        <label class="mb-1 block font-medium">Consultation Charges</label>
                        <input type="number"
                               id="ConsultationCharges"
                               name="ConsultationCharges"
                               step="0.01"
                               class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-200
                                      focus:ring-2 focus:ring-purple-500">
                    </div>

                    <div>
                        <label class="mb-1 block font-medium">OPD Consultation Fee</label>
                        <input type="number"
                               id="OpdConsultationFee"
                               name="OpdConsultationFee"
                               step="0.01"
                               class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-200
                                      focus:ring-2 focus:ring-purple-500">
                    </div>

                    <div class="md:col-span-2">
                        <label class="mb-1 block font-medium">Notes</label>
                        <textarea id="Notes"
                                  name="Notes"
                                  rows="2"
                                  class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-200
                                         focus:ring-2 focus:ring-purple-500"></textarea>
                    </div>

                </div>
            </form>
        </div>

        <!-- Footer -->
        <div class="flex justify-end gap-3 rounded-b-xl border-t border-gray-700 bg-gray-900 px-6 py-4">
            <button type="button"
                    class="rounded-lg bg-gray-700 px-4 py-2 text-gray-200 hover:bg-gray-600"
                    onclick="closeModal('addBillModal')">
                Cancel
            </button>

            <button id="btnSaveBill"
                    class="rounded-lg bg-purple-600 px-4 py-2 font-semibold text-white hover:bg-purple-700">
                Save Bill
            </button>
        </div>

    </div>
</div>


<!-- Edit Bill Modal -->
<div id="editBillModal"
     class="fixed inset-0 z-50 flex hidden items-center justify-center bg-black/60 backdrop-blur-sm">

    <div class="w-full max-w-3xl rounded-xl border border-gray-700 bg-gray-800 text-gray-200 shadow-xl">

        <!-- Header -->
        <div class="flex items-center justify-between rounded-t-xl bg-yellow-500 px-6 py-4 text-black">
            <h5 class="text-lg font-semibold">Edit Bill</h5>
            <button type="button"
                    class="text-xl text-black hover:text-gray-700"
                    data-bs-dismiss="modal"
                    onclick="closeModal('editBillModal')">
                ✕
            </button>
        </div>

        <!-- Body -->
        <div class="p-6">
            <form id="editBillForm">
                @Html.AntiForgeryToken()

                <input type="hidden" id="EditBillId" name="Id" />
                <input type="hidden" id="EditPatientId" name="PatientId" />
                <input type="hidden" id="EditVisitId" name="VisitId" />

                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">

                    <div>
                        <label class="mb-1 block font-medium">Bill Date</label>
                        <input type="date"
                               id="EditBillDate"
                               required
                               class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-200 focus:ring-2 focus:ring-purple-500">
                    </div>

                    <div>
                        <label class="mb-1 block font-medium">Payment Status</label>
                        <select id="EditPaymentStatus"
                                class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-200 focus:ring-2 focus:ring-purple-500">
                            <option value="Unpaid">Unpaid</option>
                            <option value="Paid">Paid</option>
                            <option value="Partial">Partial</option>
                        </select>
                    </div>

                    <div>
                        <label class="mb-1 block font-medium">Payment Mode</label>
                        <select id="EditPaymentMode"
                                class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-200 focus:ring-2 focus:ring-purple-500">
                            <option value="">-- Select --</option>
                            <option value="Cash">Cash</option>
                            <option value="Card">Card</option>
                            <option value="Insurance">Insurance</option>
                        </select>
                    </div>

                    <div>
                        <label class="mb-1 block font-medium">Room Charges</label>
                        <input type="number" id="EditRoomCharges" step="0.01"
                               class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-200 focus:ring-2 focus:ring-purple-500">
                    </div>

                    <div>
                        <label class="mb-1 block font-medium">Procedure Charges</label>
                        <input type="number" id="EditProcedureCharges" step="0.01"
                               class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-200 focus:ring-2 focus:ring-purple-500">
                    </div>

                    <div>
                        <label class="mb-1 block font-medium">Medication Charges</label>
                        <input type="number" id="EditMedicationCharges" step="0.01"
                               class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-200 focus:ring-2 focus:ring-purple-500">
                    </div>

                    <div>
                        <label class="mb-1 block font-medium">Consultation Charges</label>
                        <input type="number" id="EditConsultationCharges" step="0.01"
                               class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-200 focus:ring-2 focus:ring-purple-500">
                    </div>

                    <div>
                        <label class="mb-1 block font-medium">OPD Fee</label>
                        <input type="number" id="EditOpdConsultationFee" step="0.01"
                               class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-200 focus:ring-2 focus:ring-purple-500">
                    </div>

                    <div>
                        <label class="mb-1 block font-medium">Discount</label>
                        <input type="number" id="EditDiscountAmount" step="0.01"
                               class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-200 focus:ring-2 focus:ring-purple-500">
                    </div>

                    <div>
                        <label class="mb-1 block font-medium">Total Amount</label>
                        <input type="number" id="EditTotalAmount" readonly
                               class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-400">
                    </div>

                    <div>
                        <label class="mb-1 block font-medium">Net Amount</label>
                        <input type="number" id="EditNetAmount" readonly
                               class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-400">
                    </div>

                    <div class="md:col-span-2">
                        <label class="mb-1 block font-medium">Notes</label>
                        <textarea id="EditNotes" rows="2"
                                  class="w-full rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-gray-200 focus:ring-2 focus:ring-purple-500"></textarea>
                    </div>

                </div>
            </form>
        </div>

        <!-- Footer -->
        <div class="flex justify-end gap-3 rounded-b-xl border-t border-gray-700 bg-gray-900 px-6 py-4">
            <button type="button"
                    class="rounded-lg bg-gray-700 px-4 py-2 text-gray-200 hover:bg-gray-600"
                    data-bs-dismiss="modal"
                    onclick="closeModal('editBillModal')">
                Cancel
            </button>

            <button id="btnUpdateBill"
                    class="rounded-lg bg-purple-600 px-4 py-2 font-semibold text-white hover:bg-purple-700">
                Update Bill
            </button>
        </div>

    </div>
</div>


<!-- Allot Bed Modal -->
<div id="allotBedModal" class="fixed inset-0 z-50 flex hidden items-center justify-center bg-black/50">
    <div class="max-h-[90vh] w-full max-w-md overflow-y-auto rounded-xl bg-gray-900 text-gray-100 shadow-xl">

        <!-- Modal Header -->
        <div class="flex items-center justify-between rounded-t-xl bg-purple-700 px-6 py-4 text-white">
            <h5 class="text-lg font-semibold">Allot Bed to Patient</h5>
            <button type="button" class="text-xl font-bold text-white hover:text-gray-200" onclick="document.getElementById('allotBedModal').classList.add('hidden')">&times;</button>
        </div>

        <!-- Modal Body -->
        <div class="px-6 py-4">
            <form id="allotBedForm" class="space-y-4">

                <!-- Ward Selection -->
                <div>
                    <label for="wardSelect" class="mb-1 block font-semibold">Select Ward</label>
                    <select id="wardSelect" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100" required>
                        <option value="">-- Select Ward --</option>
                    </select>
                </div>

                <!-- Bed Selection -->
                <div>
                    <label for="bedSelect" class="mb-1 block font-semibold">Select Bed</label>
                    <select id="bedSelect" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100" disabled required>
                        <option value="">-- Select Bed --</option>
                    </select>
                </div>

                <!-- Notes -->
                <div>
                    <label for="notes" class="mb-1 block font-semibold">Notes</label>
                    <textarea id="notes" rows="2" placeholder="Enter any notes (optional)" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100"></textarea>
                </div>

            </form>
        </div>

        <!-- Modal Footer -->
        <div class="flex justify-end gap-3 border-t border-gray-700 px-6 py-4">
            <button type="button" class="rounded-lg bg-gray-700 px-4 py-2 text-white transition hover:bg-gray-600" onclick="document.getElementById('allotBedModal').classList.add('hidden')">
                Cancel
            </button>
            <button type="submit" form="allotBedForm" class="rounded-lg bg-purple-600 px-4 py-2 text-white transition hover:bg-purple-500">
                Assign
            </button>
        </div>

    </div>
</div>


<!-- Patient Bed Status Modal -->
<div id="checkBedModal" class="fixed inset-0 z-50 flex hidden items-center justify-center bg-black/50">
    <div class="max-h-[90vh] w-full max-w-4xl overflow-y-auto rounded-xl bg-gray-900 text-gray-100 shadow-xl">

        <!-- Modal Header -->
        <div class="flex items-center justify-between rounded-t-xl bg-purple-700 px-6 py-4 text-white">
            <h5 class="text-lg font-semibold">Patient Bed Status</h5>
            <button type="button" class="text-xl font-bold text-white hover:text-gray-200" onclick="document.getElementById('checkBedModal').classList.add('hidden')">&times;</button>
        </div>

        <!-- Modal Body -->
        <div class="space-y-6 px-6 py-4">

            <!-- Ward Information -->
            <div class="mb-4">
                <h6 class="mb-2 font-semibold text-gray-300">Ward Information</h6>
                <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
                    <div><span class="font-semibold">Ward:</span> <span id="wardName"></span></div>
                    <div><span class="font-semibold">Capacity:</span> <span id="wardCapacity"></span></div>
                    <div><span class="font-semibold">Occupied:</span> <span id="wardOccupied"></span></div>
                </div>
            </div>

            <!-- Bed Grid -->
            <div id="bedGridContainer" class="flex flex-wrap gap-2"></div>

            <!-- Legend -->
            <div class="mt-4 flex items-center gap-3">
                <span class="rounded-lg bg-green-600 px-3 py-1 text-sm text-white">Available</span>
                <span class="rounded-lg bg-red-600 px-3 py-1 text-sm text-white">Occupied</span>
                <span class="rounded-lg bg-purple-600 px-3 py-1 text-sm text-white">Patient’s Bed</span>
            </div>

        </div>

        <!-- Modal Footer -->
        <div class="flex justify-end border-t border-gray-700 px-6 py-4">
            <button type="button" class="rounded-lg bg-gray-700 px-4 py-2 text-white transition hover:bg-gray-600" onclick="document.getElementById('checkBedModal').classList.add('hidden')">
                Close
            </button>
        </div>

    </div>
</div>


<!-- Doctor Round Modal -->
<div id="doctorRoundModal" class="fixed inset-0 z-50 flex hidden items-center justify-center bg-black/50">
    <div class="max-h-[90vh] w-full max-w-4xl overflow-y-auto rounded-xl bg-gray-900 text-gray-100 shadow-xl">

        <!-- Modal Header -->
        <div class="flex items-center justify-between rounded-t-xl bg-purple-700 px-6 py-4 text-white">
            <h5 class="text-lg font-semibold">Add Doctor Round</h5>
            <button type="button" class="text-xl font-bold text-white hover:text-gray-200" onclick="document.getElementById('doctorRoundModal').classList.add('hidden')">&times;</button>
        </div>

        <!-- Modal Form -->
        <form id="doctorRoundForm" class="space-y-6 px-6 py-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="PatientId" name="PatientId" value="@Model.PatientId" />
            <input type="hidden" id="VisitId" name="VisitId" value="@Model.VisitId" />

            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">

                <div>
                    <label class="mb-1 block font-semibold">Doctor</label>
                    <select id="DoctorId" name="DoctorId" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100" required>
                        <option value="">Select Doctor</option>
                    </select>
                </div>

                <div>
                    <label class="mb-1 block font-semibold">Round Date</label>
                    <input type="datetime-local" id="RoundDate" name="RoundDate" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100" required />
                </div>

                <div class="md:col-span-2">
                    <label class="mb-1 block font-semibold">Observations</label>
                    <textarea id="Observations" name="Observations" rows="2" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100"></textarea>
                </div>

                <div class="md:col-span-2">
                    <label class="mb-1 block font-semibold">Diagnosis</label>
                    <textarea id="Diagnosis" name="Diagnosis" rows="2" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100"></textarea>
                </div>

                <div class="md:col-span-2">
                    <label class="mb-1 block font-semibold">Prescriptions</label>
                    <textarea id="Prescriptions" name="Prescriptions" rows="2" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100"></textarea>
                </div>

                <div class="md:col-span-2">
                    <label class="mb-1 block font-semibold">Tests Recommended</label>
                    <textarea id="TestsRecommended" name="TestsRecommended" rows="2" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100"></textarea>
                </div>

                <div class="md:col-span-2">
                    <label class="mb-1 block font-semibold">Treatment Plan</label>
                    <textarea id="TreatmentPlan" name="TreatmentPlan" rows="2" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100"></textarea>
                </div>

                <div class="md:col-span-2">
                    <label class="mb-1 block font-semibold">Follow-up Instructions</label>
                    <textarea id="FollowUpInstructions" name="FollowUpInstructions" rows="2" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100"></textarea>
                </div>

                <div>
                    <label class="mb-1 block font-semibold">Is Critical</label>
                    <select id="IsCritical" name="IsCritical" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100" required>
                        <option value="">Select</option>
                        <option value="true">Yes</option>
                        <option value="false">No</option>
                    </select>
                </div>

            </div>

            <!-- Modal Footer -->
            <div class="flex justify-end gap-3 border-t border-gray-700 pt-4">
                <button type="button" class="rounded-lg bg-gray-700 px-4 py-2 text-white transition hover:bg-gray-600" id="btnCloseDoctorRound" onclick="document.getElementById('doctorRoundModal').classList.add('hidden')">
                    Close
                </button>
                <button type="submit" class="rounded-lg bg-purple-600 px-4 py-2 text-white transition hover:bg-purple-500">
                    Save Round
                </button>
            </div>

        </form>
    </div>
</div>

