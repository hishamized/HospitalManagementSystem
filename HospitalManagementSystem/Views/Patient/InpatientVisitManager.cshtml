<!-- Final Bill Modal -->
<div id="finalBillModal" class="fixed inset-0 z-50 flex hidden items-center justify-center bg-black/50">
    <div class="max-h-[90vh] w-full max-w-4xl overflow-y-auto rounded-xl bg-gray-900 text-gray-100 shadow-xl">

        <!-- Modal Header -->
        <div class="flex items-center justify-between rounded-t-xl bg-purple-700 px-6 py-4 text-white">
            <h5 class="flex items-center gap-2 text-lg font-semibold">
                <i class="bi bi-file-earmark-text"></i> Final Bill Summary
            </h5>
            <button type="button" class="text-xl font-bold text-white hover:text-gray-200" onclick="document.getElementById('finalBillModal').classList.add('hidden')">&times;</button>
        </div>

        <!-- Modal Body -->
        <div id="billContent" class="space-y-6 px-6 py-4">

            <!-- Hospital Header -->
            <div class="text-center">
                <h3 class="text-xl font-bold">Hospital Management System</h3>
                <p class="mb-0 text-gray-400">Final Discharge Bill</p>
            </div>

            <hr class="border-gray-700" />

            <!-- Patient & Visit Information -->
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                <!-- Patient Information -->
                <div>
                    <h6 class="mb-2 font-bold text-purple-500">Patient Information</h6>
                    <table class="w-full table-auto text-gray-100">
                        <tbody class="text-sm">
                            <tr>
                                <td class="pr-2 font-semibold">Patient Name:</td>
                                <td id="billPatientName">@Model.FullName</td>
                            </tr>
                            <tr>
                                <td class="pr-2 font-semibold">Patient Code:</td>
                                <td id="billPatientId">@Model.PatientCode</td>
                            </tr>
                            <tr>
                                <td class="pr-2 font-semibold">Gender:</td>
                                <td id="billAgeGender">@Model.Gender</td>
                            </tr>
                            <tr>
                                <td class="pr-2 font-semibold">Contact:</td>
                                <td id="billContactNumber">@Model.ContactNumber</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Visit Information -->
                <div>
                    <h6 class="mb-2 font-bold text-purple-500">Visit Information</h6>
                    <table class="w-full table-auto text-gray-100">
                        <tbody class="text-sm">
                            <tr>
                                <td class="pr-2 font-semibold">Visit ID:</td>
                                <td id="billVisitId">@Model.VisitId</td>
                            </tr>
                            <tr>
                                <td class="pr-2 font-semibold">Admission Date:</td>
                                <td id="billAdmissionDate">@Model.AdmissionDate</td>
                            </tr>
                            <tr>
                                <td class="pr-2 font-semibold">Discharge Date:</td>
                                <td id="billDischargeDate">@Model.DischargeDate</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <hr class="border-gray-700" />

            <!-- Charges Breakdown -->
            <div>
                <h6 class="mb-2 font-bold text-purple-500">Charges Breakdown</h6>
                <table class="w-full table-auto border border-gray-700 text-sm text-gray-100">
                    <thead class="bg-gray-800">
                        <tr>
                            <th class="px-2 py-1 text-left">Description</th>
                            <th class="px-2 py-1 text-right">Amount (₹)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="px-2 py-1">Room Charges</td>
                            <td class="px-2 py-1 text-right" id="billRoomCharges">0.00</td>
                        </tr>
                        <tr>
                            <td class="px-2 py-1">Consultation Charges</td>
                            <td class="px-2 py-1 text-right" id="billConsultationCharges">0.00</td>
                        </tr>
                        <tr>
                            <td class="px-2 py-1">Procedure Charges</td>
                            <td class="px-2 py-1 text-right" id="billProcedureCharges">0.00</td>
                        </tr>
                        <tr>
                            <td class="px-2 py-1">Medication Charges</td>
                            <td class="px-2 py-1 text-right" id="billMedicationCharges">0.00</td>
                        </tr>
                        <tr>
                            <td class="px-2 py-1">OPD Consultation Fee</td>
                            <td class="px-2 py-1 text-right" id="billOpdConsultationFee">0.00</td>
                        </tr>
                        <tr class="bg-gray-800 font-bold">
                            <td class="px-2 py-1">Subtotal</td>
                            <td class="px-2 py-1 text-right" id="billSubtotal">0.00</td>
                        </tr>
                        <tr class="bg-yellow-600 font-semibold">
                            <td class="px-2 py-1">Discount</td>
                            <td class="px-2 py-1 text-right" id="billDiscountAmount">0.00</td>
                        </tr>
                        <tr class="bg-green-600 text-lg font-bold">
                            <td class="px-2 py-1">Net Amount Payable</td>
                            <td class="px-2 py-1 text-right" id="billNetAmount">0.00</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Additional Notes -->
            <div id="billNotesSection" class="hidden">
                <h6 class="mb-1 font-bold text-purple-500">Additional Notes</h6>
                <p class="text-gray-400" id="billNotes"></p>
            </div>

            <hr class="border-gray-700" />

            <!-- Footer -->
            <div class="text-center text-sm text-gray-400">
                <p class="mb-1">Thank you for choosing our services!</p>
                <p class="mb-0">Generated on: <span id="billGeneratedDate"></span></p>
            </div>

        </div>

        <!-- Modal Footer -->
        <div class="flex justify-end gap-3 border-t border-gray-700 px-6 py-4">
            <button type="button" class="rounded-lg bg-gray-700 px-4 py-2 text-white transition hover:bg-gray-600" onclick="document.getElementById('finalBillModal').classList.add('hidden')">
                <i class="bi bi-x-circle"></i> Close
            </button>
            <button type="button" id="btnDownloadBill" class="flex items-center gap-2 rounded-lg bg-purple-600 px-4 py-2 text-white transition hover:bg-purple-500">
                <i class="bi bi-download"></i> Download PDF
            </button>
        </div>

    </div>
</div>


