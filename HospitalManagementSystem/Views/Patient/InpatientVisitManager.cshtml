                </div>

                <div class="md:col-span-2">
                    <label class="mb-1 block font-semibold">Observations</label>
                    <textarea id="EditObservations" name="Observations" rows="2" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100"></textarea>
                </div>

                <div class="md:col-span-2">
                    <label class="mb-1 block font-semibold">Diagnosis</label>
                    <textarea id="EditDiagnosis" name="Diagnosis" rows="2" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100"></textarea>
                </div>

                <div class="md:col-span-2">
                    <label class="mb-1 block font-semibold">Prescriptions</label>
                    <textarea id="EditPrescriptions" name="Prescriptions" rows="2" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100"></textarea>
                </div>

                <div class="md:col-span-2">
                    <label class="mb-1 block font-semibold">Tests Recommended</label>
                    <textarea id="EditTestsRecommended" name="TestsRecommended" rows="2" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100"></textarea>
                </div>

                <div class="md:col-span-2">
                    <label class="mb-1 block font-semibold">Treatment Plan</label>
                    <textarea id="EditTreatmentPlan" name="TreatmentPlan" rows="2" class="w-full rounded-lg border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100"></textarea>
                </div>

                <div class="md:col-span-2">
                    <label class="mb-1 block font-semibold">Follow-up Instructions</label>
