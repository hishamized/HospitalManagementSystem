@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="content-page bg-gray-900 text-gray-200 min-h-screen">

    <div class="content">

        <div class="max-w-screen-xl mx-auto px-4 py-6">

            <!-- Page Title -->
            <div class="mb-6">
                <h1 class="text-3xl font-bold text-purple-400">
                    Admin Dashboard
                </h1>
                <p class="text-gray-400 mt-2">Manage your hospital operations efficiently</p>
            </div>

            <!-- Logout Button -->
            <div class="my-6">
                <form method="post" asp-controller="User" asp-action="Logout">
                    <button type="submit"
                            class="w-full bg-red-600 hover:bg-red-700 text-white font-semibold py-2 rounded-lg shadow-lg transition">
                        Logout
                    </button>
                </form>
            </div>

            <!-- Features Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">

                <!-- Patient Management -->
                <div class="bg-gray-800 rounded-2xl shadow-xl p-6 border border-gray-700 hover:border-purple-500 transition duration-300">
                    <div class="flex justify-center mb-4">
                        <svg class="w-16 h-16 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-purple-300 text-center mb-3">
                        Patient Management
                    </h3>
                    <p class="text-gray-400 text-center leading-relaxed">
                        Register and manage patient records, medical history, and personal information with ease.
                    </p>
                </div>

                <!-- Doctor Management -->
                <div class="bg-gray-800 rounded-2xl shadow-xl p-6 border border-gray-700 hover:border-purple-500 transition duration-300">
                    <div class="flex justify-center mb-4">
                        <svg class="w-16 h-16 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-purple-300 text-center mb-3">
                        Doctor Management
                    </h3>
                    <p class="text-gray-400 text-center leading-relaxed">
                        Manage doctor profiles, specializations, schedules, and availability across departments.
                    </p>
                </div>

                <!-- Appointment Scheduling -->
                <div class="bg-gray-800 rounded-2xl shadow-xl p-6 border border-gray-700 hover:border-purple-500 transition duration-300">
                    <div class="flex justify-center mb-4">
                        <svg class="w-16 h-16 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-purple-300 text-center mb-3">
                        Appointment Scheduling
                    </h3>
                    <p class="text-gray-400 text-center leading-relaxed">
                        Book, reschedule, and manage patient appointments with doctors across multiple time slots.
                    </p>
                </div>

                <!-- Department Management -->
                <div class="bg-gray-800 rounded-2xl shadow-xl p-6 border border-gray-700 hover:border-purple-500 transition duration-300">
                    <div class="flex justify-center mb-4">
                        <svg class="w-16 h-16 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-purple-300 text-center mb-3">
                        Department Management
                    </h3>
                    <p class="text-gray-400 text-center leading-relaxed">
                        Organize hospital departments, assign doctors, and manage departmental resources efficiently.
                    </p>
                </div>

                <!-- Time Slot Management -->
                <div class="bg-gray-800 rounded-2xl shadow-xl p-6 border border-gray-700 hover:border-purple-500 transition duration-300">
                    <div class="flex justify-center mb-4">
                        <svg class="w-16 h-16 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-purple-300 text-center mb-3">
                        Time Slot Management
                    </h3>
                    <p class="text-gray-400 text-center leading-relaxed">
                        Configure and manage doctor availability slots for efficient appointment scheduling.
                    </p>
                </div>

                <!-- Lab Tests & Reports -->
                <div class="bg-gray-800 rounded-2xl shadow-xl p-6 border border-gray-700 hover:border-purple-500 transition duration-300">
                    <div class="flex justify-center mb-4">
                        <svg class="w-16 h-16 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-purple-300 text-center mb-3">
                        Lab Tests & Reports
                    </h3>
                    <p class="text-gray-400 text-center leading-relaxed">
                        Request lab tests, track their status, and manage patient reports and analytics.
                    </p>
                </div>

                <!-- Reports & Analytics -->
                <div class="bg-gray-800 rounded-2xl shadow-xl p-6 border border-gray-700 hover:border-purple-500 transition duration-300">
                    <div class="flex justify-center mb-4">
                        <svg class="w-16 h-16 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-purple-300 text-center mb-3">
                        Reports & Analytics
                    </h3>
                    <p class="text-gray-400 text-center leading-relaxed">
                        Generate comprehensive reports and view analytics to monitor hospital performance.
                    </p>
                </div>

                <!-- Doctor Portal -->
                <div class="bg-gray-800 rounded-2xl shadow-xl p-6 border border-gray-700 hover:border-purple-500 transition duration-300">
                    <div class="flex justify-center mb-4">
                        <svg class="w-16 h-16 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-purple-300 text-center mb-3">
                        Doctor Portal
                    </h3>
                    <p class="text-gray-400 text-center leading-relaxed">
                        Dedicated portal for doctors to manage their appointments, patients, and clinical workflows.
                    </p>
                </div>

                <!-- User Management -->
                <div class="bg-gray-800 rounded-2xl shadow-xl p-6 border border-gray-700 hover:border-purple-500 transition duration-300">
                    <div class="flex justify-center mb-4">
                        <svg class="w-16 h-16 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-purple-300 text-center mb-3">
                        User Management
                    </h3>
                    <p class="text-gray-400 text-center leading-relaxed">
                        Manage user accounts, roles, and permissions with secure authentication and authorization.
                    </p>
                </div>

            </div>

        </div>
    </div>

    <!-- Footer -->
    <footer class="w-full border-t border-gray-800 py-4">
        <div class="text-center text-gray-400 text-sm">
            © 2025 Hospital Management System — Admin Panel
        </div>
    </footer>
</div>