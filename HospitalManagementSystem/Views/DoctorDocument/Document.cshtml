@{
    ViewData["Title"] = "Doctor Documents";
}

<div class="mt-4 w-full px-4 sm:px-6 lg:px-8">
    <div class="mb-3 flex items-center justify-between">
        <h4 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Doctor Documents</h4>
        <button id="btnAddDocument"
                type="button"
                class="inline-flex items-center gap-2 rounded-md bg-purple-600 px-4 py-2 text-white shadow hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900">
            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
            </svg>
            <span>Add Document</span>
        </button>
    </div>

    <div class="mb-3">
        <input type="text"
               id="quickFilter"
               placeholder="Search all columns..."
               class="block w-full rounded-md border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100 placeholder-gray-500 shadow-sm focus:border-purple-500 focus:outline-none focus:ring-2 focus:ring-purple-500" />
    </div>


    <!-- Tailwind overflow-x-auto enables horizontal scroll -->
    <div id="doctorDocumentsGrid"
         class="ag-theme-alpine-dark mx-60"
         style="min-width:1400px; height:600px;">
    </div>
</div>


<!-- Add/Edit Modal -->
<div id="addDocumentModal"
     role="dialog"
     aria-modal="true"
     aria-labelledby="addDocumentModalLabel"
     class="fixed inset-0 z-50 hidden">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/50"></div>

    <!-- Modal panel -->
    <div class="relative z-10 flex min-h-screen items-center justify-center p-4">
        <form id="documentForm" enctype="multipart/form-data"
              class="w-full max-w-lg rounded-lg bg-gray-900 shadow-lg"
              novalidate>
            <!-- Modal Header -->
            <div class="flex items-center justify-between rounded-t-lg bg-purple-600 px-4 py-3 text-white">
                <h5 class="text-base font-semibold" id="addDocumentModalLabel">Add Document</h5>
                <button type="button"
                        aria-label="Close"
                        class="inline-flex h-8 w-8 items-center justify-center rounded hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white"
                        onclick="toggleModal('addDocumentModal', 'hide')">
                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd"
                              d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                              clip-rule="evenodd" />
                    </svg>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="px-4 py-4">
                <input type="hidden" id="documentId" name="Id" />

                <!-- Doctor Dropdown -->
                <div class="mb-4">
                    <label for="doctorSelect" class="mb-1 block text-sm font-semibold text-gray-200">Doctor</label>
                    <select id="doctorSelect"
                            name="DoctorId"
                            required
                            class="block w-full rounded-md border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100 shadow-sm focus:border-purple-500 focus:outline-none focus:ring-2 focus:ring-purple-500">
                        <option value="">-- Select Doctor --</option>
                    </select>
                    <p class="mt-1 hidden text-sm text-red-600">Please select a doctor.</p>
                </div>

                <!-- File Upload -->
                <div class="mb-4">
                    <label for="fileUpload" class="mb-1 block text-sm font-semibold text-gray-200">Document File</label>
                    <input type="file"
                           id="fileUpload"
                           name="file"
                           accept=".pdf,.jpg,.png,.doc,.docx"
                           required
                           class="block w-full cursor-pointer rounded-md border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100 shadow-sm file:mr-4 file:rounded-md file:border-0 file:bg-purple-600 file:px-3 file:py-2 file:text-sm file:font-medium file:text-white focus:border-purple-500 focus:outline-none focus:ring-2 focus:ring-purple-500 hover:file:bg-purple-700" />
                    <p class="mt-1 hidden text-sm text-red-600">Please upload a document file.</p>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="flex items-center justify-end gap-3 rounded-b-lg bg-gray-800 px-4 py-3">
                <button type="button"
                        class="inline-flex items-center rounded-md border border-gray-600 px-4 py-2 text-sm font-medium text-gray-200 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-purple-500"
                        onclick="toggleModal('addDocumentModal', 'hide')">
                    Cancel
                </button>
                <button type="submit"
                        class="inline-flex items-center rounded-md bg-purple-600 px-4 py-2 text-sm font-medium text-white shadow hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-purple-500">
                    Save Document
                </button>
            </div>
        </form>
    </div>
</div>


<!-- Edit Document Modal -->
<div id="editDocumentModal"
     role="dialog"
     aria-modal="true"
     aria-labelledby="editDocumentModalLabel"
     class="fixed inset-0 z-50 hidden">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/50"></div>

    <!-- Modal panel -->
    <div class="relative z-10 flex min-h-screen items-center justify-center p-4">
        <form id="editDocumentForm" enctype="multipart/form-data"
              class="w-full max-w-lg rounded-lg bg-gray-900 shadow-lg"
              novalidate>
            @Html.AntiForgeryToken()

            <!-- Modal Header -->
            <div class="flex items-center justify-between rounded-t-lg bg-purple-600 px-4 py-3 text-white">
                <h5 class="text-base font-semibold" id="editDocumentModalLabel">Edit Document</h5>
                <button type="button"
                        aria-label="Close"
                        class="inline-flex h-8 w-8 items-center justify-center rounded hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white"
                        onclick="toggleModal('editDocumentModal', 'hide')">
                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd"
                              d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                              clip-rule="evenodd" />
                    </svg>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="px-4 py-4">
                <!-- Hidden IDs -->
                <input type="hidden" id="editDocumentId" name="Id" />
                <input type="hidden" id="editDoctorId" name="DoctorId" />
                <input type="hidden" id="editOldFilePath" name="OldFilePath" />
                <input type="hidden" id="editOldFileName" name="OldFileName" />

                <!-- Doctor Name (disabled) -->
                <div class="mb-4">
                    <label for="editDoctorName" class="mb-1 block text-sm font-semibold text-gray-200">Doctor</label>
                    <input type="text"
                           id="editDoctorName"
                           disabled
                           class="block w-full cursor-not-allowed rounded-md border border-gray-700 bg-gray-800 px-3 py-2 text-gray-300 shadow-sm" />
                </div>

                <!-- File Upload -->
                <div class="mb-4">
                    <label for="editFileUpload" class="mb-1 block text-sm font-semibold text-gray-200">Upload New Document</label>
                    <input type="file"
                           id="editFileUpload"
                           name="file"
                           accept=".pdf,.jpg,.png,.doc,.docx"
                           required
                           class="block w-full cursor-pointer rounded-md border border-gray-700 bg-gray-800 px-3 py-2 text-gray-100 shadow-sm file:mr-4 file:rounded-md file:border-0 file:bg-purple-600 file:px-3 file:py-2 file:text-sm file:font-medium file:text-white focus:border-purple-500 focus:outline-none focus:ring-2 focus:ring-purple-500 hover:file:bg-purple-700" />
                    <p class="mt-1 hidden text-sm text-red-600">Please select a file to upload.</p>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="flex items-center justify-end gap-3 rounded-b-lg bg-gray-800 px-4 py-3">
                <button type="button"
                        class="inline-flex items-center rounded-md border border-gray-600 px-4 py-2 text-sm font-medium text-gray-200 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-purple-500"
                        onclick="toggleModal('editDocumentModal', 'hide')">
                    Cancel
                </button>
                <button type="submit"
                        class="inline-flex items-center rounded-md bg-purple-600 px-4 py-2 text-sm font-medium text-white shadow hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-purple-500">
                    Update Document
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/DoctorDocument/doctorDocument.js"></script>
}