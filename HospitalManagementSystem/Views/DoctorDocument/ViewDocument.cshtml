@{
    ViewData["Title"] = "Doctor List";
}

<div class="mt-4 w-full px-4 sm:px-6 lg:px-8">
    <h4 class="mb-3 text-xl font-bold text-purple-600">Doctors</h4>

    <!-- ✅ AG Grid container -->
    <div id="doctorGrid" class="ag-theme-alpine-dark mx-60 h-[500px]"></div>
</div>

<!-- 🧾 Modal for Doctor Documents -->
<div id="doctorDocumentsModal"
     role="dialog"
     aria-modal="true"
     aria-labelledby="doctorDocumentsLabel"
     class="fixed inset-0 z-50 hidden">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/50"></div>

    <!-- Modal panel -->
    <div class="relative z-10 flex min-h-screen items-center justify-center p-4">
        <div class="w-full max-w-4xl overflow-hidden rounded-lg bg-gray-900 shadow-lg">
            <!-- Modal Header -->
            <div class="flex items-center justify-between bg-purple-600 px-4 py-3 text-white">
                <h5 class="text-base font-semibold" id="doctorDocumentsLabel">Doctor Documents</h5>
                <button type="button"
                        id="btnCloseDoctorDocumentsModal"
                        onclick="hideModal('doctorDocumentsModal')"
                        data-modal="doctorDocumentsModal"
                        aria-label="Close"
                        class="inline-flex h-8 w-8 items-center justify-center rounded hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white">
                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd"
                              d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                              clip-rule="evenodd" />
                    </svg>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-4">
                <div id="doctorDocumentsContainer"
                     class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                    <!-- Document cards will be inserted here dynamically -->
                    <!-- Example card -->
                    <!--
                    <div class="rounded-md bg-gray-800 p-4 shadow transition hover:shadow-lg">
                        <h6 class="truncate text-sm font-semibold text-gray-100">Document Name.pdf</h6>
                        <button class="mt-2 flex items-center gap-1 rounded border border-purple-600 px-2 py-1 text-sm text-purple-600 hover:bg-purple-600 hover:text-white">
                            <i class="fas fa-external-link-alt"></i> View
                        </button>
                    </div>
                    -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Doctor/viewDoctor.js"></script>
}
