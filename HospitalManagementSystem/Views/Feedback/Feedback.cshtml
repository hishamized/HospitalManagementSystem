@{
    ViewData["Title"] = "Feedback Management";
}

<div class="min-h-screen bg-gray-900 p-6">
    <div class="max-w-7xl mx-auto">
        <div class="bg-gray-800 rounded-2xl shadow-2xl border border-gray-700 overflow-hidden">

            <!-- Header -->
            <div class="bg-gray-800 border-b border-gray-700 px-6 py-4">
                <div class="flex items-center justify-between">
                    <h4 class="text-2xl font-bold text-purple-400 flex items-center gap-2">
                        <i class="fas fa-comments"></i>
                        Patient Feedback Management
                    </h4>
                    <button class="bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 text-white font-semibold px-4 py-2 rounded-lg shadow-lg transition-all flex items-center gap-2"
                            onclick="window.showModal('addFeedbackModal')">
                        <i class="fas fa-plus-circle"></i>
                        Add Feedback
                    </button>
                </div>
            </div>

            <!-- Message Container -->
            <div id="messageContainer" class="px-6 pt-4"></div>

            <!-- Grid Body -->
            <div class="p-6">
                <div id="feedbackGrid" class="ag-theme-alpine-dark" style="height: 600px; width: 100%;"></div>
            </div>
        </div>
    </div>
</div>

<!-- Add Feedback Modal -->
<div class="fixed inset-0 bg-black/60 flex items-center justify-center p-4 z-50 hidden"
     id="addFeedbackModal"
     tabindex="-1">
    <div class="bg-gray-800 rounded-2xl shadow-2xl border border-gray-700 w-full max-w-2xl transform transition-all max-h-[90vh] overflow-y-auto">
        <!-- Modal Header -->
        <div class="bg-gradient-to-r from-green-600 to-green-700 px-6 py-4 flex items-center justify-between rounded-t-2xl sticky top-0 z-10">
            <h5 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fas fa-comment-medical"></i>
                Submit Anonymous Feedback
            </h5>
            <button type="button"
                    class="text-white hover:text-gray-200 text-2xl transition-colors"
                    onclick="window.hideModal('addFeedbackModal')">
                &times;
            </button>
        </div>

        <!-- Modal Body -->
        <div class="p-6">
            <form id="addFeedbackForm" class="space-y-4">

                <!-- Doctor Selection -->
                <div>
                    <label for="doctorId" class="block text-gray-300 font-semibold mb-2">
                        <i class="fas fa-user-md text-purple-400 mr-2"></i>Doctor
                    </label>
                    <select id="doctorId"
                            name="DoctorId"
                            class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all"
                            required>
                        <option value="">-- Select Doctor --</option>
                    </select>
                </div>

                <!-- Rating -->
                <div>
                    <label for="rating" class="block text-gray-300 font-semibold mb-2">
                        <i class="fas fa-star text-purple-400 mr-2"></i>Rating
                    </label>
                    <select id="rating"
                            name="Rating"
                            class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all"
                            required>
                        <option value="">-- Select Rating --</option>
                        <option value="1">⭐ 1 - Very Poor (Unprofessional or unsatisfactory)</option>
                        <option value="2">⭐⭐ 2 - Poor (Needs improvement)</option>
                        <option value="3">⭐⭐⭐ 3 - Average (Acceptable)</option>
                        <option value="4">⭐⭐⭐⭐ 4 - Good (Satisfied)</option>
                        <option value="5">⭐⭐⭐⭐⭐ 5 - Excellent (Outstanding)</option>
                    </select>
                </div>

                <!-- Comments -->
                <div>
                    <label for="comments" class="block text-gray-300 font-semibold mb-2">
                        <i class="fas fa-comment-dots text-purple-400 mr-2"></i>Comments
                    </label>
                    <textarea id="comments"
                              name="Comments"
                              class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all resize-none"
                              rows="4"
                              placeholder="Enter your feedback..."></textarea>
                </div>

                <input type="hidden" id="submittedFromIP" name="SubmittedFromIP">
                <input type="hidden" id="submittedFromDevice" name="SubmittedFromDevice">

                <div class="flex justify-end gap-3 pt-4">
                    <button type="button"
                            class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-gray-300 font-semibold rounded-lg transition-colors"
                            onclick="window.hideModal('addFeedbackModal')">
                        Cancel
                    </button>
                    <button type="submit"
                            class="px-6 py-2 bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 text-white font-semibold rounded-lg shadow-lg transition-all">
                        Submit Feedback
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Feedback Modal -->
<div class="fixed inset-0 bg-black/60 flex items-center justify-center p-4 z-50 hidden"
     id="editFeedbackModal"
     tabindex="-1">
    <div class="bg-gray-800 rounded-2xl shadow-2xl border border-gray-700 w-full max-w-3xl transform transition-all max-h-[90vh] overflow-y-auto">
        <!-- Modal Header -->
        <div class="bg-purple-600 px-6 py-4 flex items-center justify-between rounded-t-2xl sticky top-0 z-10">
            <h5 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fas fa-edit"></i>
                Edit Feedback
            </h5>
            <button type="button"
                    class="text-white hover:text-gray-200 text-2xl transition-colors"
                    onclick="window.hideModal('editFeedbackModal')">
                &times;
            </button>
        </div>

        <!-- Modal Body -->
        <div class="p-6">
            <!-- Error Container -->
            <div id="editFeedbackErrors" class="bg-red-600/20 border border-red-500 text-red-300 p-3 rounded-lg mb-4 hidden"></div>

            <form id="editFeedbackForm" class="space-y-4">
                <input type="hidden" id="editFeedbackId" name="Id" />

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- Doctor -->
                    <div class="md:col-span-2">
                        <label for="editDoctorSelect" class="block text-gray-300 font-semibold mb-2">Doctor</label>
                        <select id="editDoctorSelect"
                                name="DoctorId"
                                class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                                required>
                            <option value="">Loading doctors...</option>
                        </select>
                    </div>

                    <!-- Rating -->
                    <div>
                        <label for="editRatingSelect" class="block text-gray-300 font-semibold mb-2">Rating</label>
                        <select id="editRatingSelect"
                                name="Rating"
                                class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                                required>
                            <option value="">Select</option>
                            <option value="1">⭐ 1</option>
                            <option value="2">⭐⭐ 2</option>
                            <option value="3">⭐⭐⭐ 3</option>
                            <option value="4">⭐⭐⭐⭐ 4</option>
                            <option value="5">⭐⭐⭐⭐⭐ 5</option>
                        </select>
                    </div>
                </div>

                <!-- Comments -->
                <div>
                    <label for="editComments" class="block text-gray-300 font-semibold mb-2">Comments</label>
                    <textarea id="editComments"
                              name="Comments"
                              class="w-full bg-gray-700 border border-gray-600 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all resize-none"
                              rows="4"></textarea>
                </div>

                <input type="hidden" id="editSubmittedFromIP" name="SubmittedFromIP" />
                <input type="hidden" id="editSubmittedFromDevice" name="SubmittedFromDevice" />

                <div class="flex justify-end gap-3 pt-4">
                    <button type="button"
                            class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-gray-300 font-semibold rounded-lg transition-colors"
                            onclick="window.hideModal('editFeedbackModal')">
                        Cancel
                    </button>
                    <button type="submit"
                            id="updateFeedbackBtn"
                            class="px-6 py-2 bg-gradient-to-r from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 text-white font-semibold rounded-lg shadow-lg transition-all">
                        Update Feedback
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <!-- AG Grid CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@31.0.1/styles/ag-grid.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community@31.0.1/styles/ag-theme-alpine.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* AG Grid Dark Theme Customization */
        .ag-theme-alpine-dark {
            --ag-background-color: #1f2937;
            --ag-header-background-color: #374151;
            --ag-odd-row-background-color: #1f2937;
            --ag-row-hover-color: #374151;
            --ag-foreground-color: #e5e7eb;
            --ag-border-color: #4b5563;
            --ag-header-foreground-color: #a78bfa;
        }

            .ag-theme-alpine-dark ::-webkit-scrollbar {
                width: 8px;
                height: 8px;
            }

            .ag-theme-alpine-dark ::-webkit-scrollbar-track {
                background: #1f2937;
            }

            .ag-theme-alpine-dark ::-webkit-scrollbar-thumb {
                background: #6b7280;
                border-radius: 4px;
            }

                .ag-theme-alpine-dark ::-webkit-scrollbar-thumb:hover {
                    background: #9333ea;
                }
    </style>
}

@section Scripts {
    <!-- AG Grid JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/ag-grid-community@31.0.1/dist/ag-grid-community.min.js"></script>

    <script>
        // Modal helper functions
        window.showModal = function(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
        };

        window.hideModal = function(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        };

        // Close modals on escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                hideModal('addFeedbackModal');
                hideModal('editFeedbackModal');
            }
        });

        // Close modals on backdrop click
        document.getElementById('addFeedbackModal').addEventListener('click', function(e) {
            if (e.target === this) {
                hideModal('addFeedbackModal');
            }
        });

        document.getElementById('editFeedbackModal').addEventListener('click', function(e) {
            if (e.target === this) {
                hideModal('editFeedbackModal');
            }
        });
    </script>

    <script src="~/js/Feedback/feedback.js"></script>
}