@{
    ViewData["Title"] = "Check Feedback";
}

<div class="min-h-screen bg-gray-900 p-6">
    <div class="max-w-6xl mx-auto space-y-10">

        <!-- HEADER -->
        <header class="text-center">
            <h1 class="text-3xl md:text-4xl font-bold text-white">Doctor Feedback Viewer</h1>
            <p class="text-gray-400 mt-1">View feedback ratings for doctors across the hospital</p>
        </header>

        <!-- SEARCH / FILTER CARD -->
        <div class="bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-700">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                <div class="md:col-span-3">
                    <label for="doctorSelect" class="block text-gray-300 font-medium mb-2">Select Doctor</label>
                    <select id="doctorSelect"
                            class="w-full bg-gray-700 border border-gray-600 text-gray-200 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition">
                        <option value="">-- Select a Doctor --</option>
                    </select>
                </div>
                <div>
                    <button id="checkFeedbackBtn"
                            class="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2 px-4 rounded-lg shadow transition transform hover:scale-105 active:scale-95">
                        <i class="fas fa-search mr-2"></i> Check Feedback
                    </button>
                </div>
            </div>
        </div>

        <!-- FEEDBACK CARDS -->
        <div id="feedbackContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Feedback cards will appear here dynamically -->
            <!-- Example card structure for reference -->
