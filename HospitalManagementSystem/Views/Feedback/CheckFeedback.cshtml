                </div>
                <p class="text-gray-300 mt-2 text-sm line-clamp-3">"Dr. Doe was very attentive and explained everything clearly..."</p>
            </div>
            -->
        </div>

    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        /* Optional: subtle fade-in for cards */
        .feedback-card {
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUp 0.5s forwards;
        }

            .feedback-card:nth-child(1) {
                animation-delay: 0.1s;
            }

            .feedback-card:nth-child(2) {
                animation-delay: 0.2s;
            }

            .feedback-card:nth-child(3) {
                animation-delay: 0.3s;
            }

        @@keyframes fadeInUp {
            to

        {
            opacity: 1;
            transform: translateY(0);
        }

        }
    </style>
}

@section Scripts {
    <script src="~/js/Feedback/checkfeedback.js"></script>
}
